        <flowNodeRef>_ea62c9f5-0b3d-4817-a5e4-1c8f7b3d9026</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Antrag eingegangen" id="_a8f3b6d2-1e75-4c09-b4a8-59d0e2c7f361">
      <outgoing>_d8a2f0c4-7e1b-4635-9a8d-3c5e1b9f6072</outgoing>
      <messageEventDefinition id="messageEventDefinition_a8f3b6d2-1e75-4c09-b4a8-59d0e2c7f361"/>
    </startEvent>

    <task name="Antrag erfassen" id="_0e5d7a93-b2c6-4818-9f40-c3a1d8e6b727" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung nimmt den eingegangenen Wohngeldantrag mit den Nachweisen entgegen und erfasst ihn mit Eingangsdatum in der Fachanwendung. Ergebnis ist ein registrierter Antrag.</documentation>
      <incoming>_d8a2f0c4-7e1b-4635-9a8d-3c5e1b9f6072</incoming>
      <outgoing>_4a6e1d9b-c0f3-4782-b5a1-e9d7c2f38a06</outgoing>
    </task>

    <task name="Zuständigkeit und Vollständigkeit prüfen" id="_f4c1e8b0-3a96-4d72-8e5b-7d2f0a9c1b48" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung prüft die örtliche Zuständigkeit der Behörde und die Vollständigkeit der Antragsunterlagen. Ergebnis ist ein zuständigkeitsgeprüfter und vollständiger Antrag.</documentation>
      <incoming>_4a6e1d9b-c0f3-4782-b5a1-e9d7c2f38a06</incoming>
      <outgoing>_f7c3a5e2-1b84-4d09-8c6f-0a2d9e7b4135</outgoing>
    </task>

    <task name="Anspruchsvoraussetzungen prüfen" id="_73a9d0c5-8f2e-4b61-a3d7-e1b5c4f98206" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung prüft anhand der Nachweise zu Wohnkosten, Einkommen und Haushaltsgröße, ob die Voraussetzungen für einen Wohngeldanspruch vorliegen. Ergebnis ist die festgestellte Anspruchsberechtigung.</documentation>
      <incoming>_f7c3a5e2-1b84-4d09-8c6f-0a2d9e7b4135</incoming>
      <outgoing>_08d9b1f6-a5c2-4e37-96b4-d1f8a3c7e520</outgoing>
    </task>

    <task name="Wohngeld berechnen" id="_c6b2f7e1-5d08-49a3-b71c-2e9a6d0f4583" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung ermittelt auf Grundlage der geprüften Angaben die Höhe des monatlichen Wohngeldanspruchs. Ergebnis ist der berechnete Wohngeldbetrag.</documentation>
      <incoming>_08d9b1f6-a5c2-4e37-96b4-d1f8a3c7e520</incoming>
      <outgoing>_9d2e7c40-6f1a-4b85-a3d8-5e0c9b2f1a74</outgoing>
    </task>

    <task name="Bescheid erstellen" id="_19e4a6d8-c3f7-4520-8b9d-a7f1e3b0c264" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung fertigt den Bewilligungsbescheid mit Wohngeldbetrag und Bewilligungszeitraum. Ergebnis ist der Wohngeldbescheid.</documentation>
      <incoming>_9d2e7c40-6f1a-4b85-a3d8-5e0c9b2f1a74</incoming>
      <outgoing>_3e5a0f8b-d2c7-4961-b84e-7a1f6d3c9052</outgoing>
    </task>

    <task name="Bescheid versenden" id="_85d0c3b7-e6a1-4f49-92e8-0b4d7a1c5f93" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung übermittelt den Wohngeldbescheid an die antragstellende Person. Ergebnis ist der bekanntgegebene Bescheid.</documentation>
      <incoming>_3e5a0f8b-d2c7-4961-b84e-7a1f6d3c9052</incoming>
      <outgoing>_c2f6b9d1-0e8a-4753-a1c9-f4b7e5d20a38</outgoing>
    </task>

    <task name="Wohngeld auszahlen" id="_3b7f1e92-a4d8-4c65-b0a3-d6c9e2f8714a" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung veranlasst die Auszahlung des bewilligten Wohngeldes an die antragstellende Person. Ergebnis ist die angewiesene Zahlung.</documentation>
      <incoming>_c2f6b9d1-0e8a-4753-a1c9-f4b7e5d20a38</incoming>
      <outgoing>_7a1c4e95-b3d0-4f68-9e27-c8a5d0f1b346</outgoing>
    </task>

    <endEvent name="Wohngeld ausgezahlt" id="_ea62c9f5-0b3d-4817-a5e4-1c8f7b3d9026">
      <incoming>_7a1c4e95-b3d0-4f68-9e27-c8a5d0f1b346</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_a8f3b6d2-1e75-4c09-b4a8-59d0e2c7f361" targetRef="_0e5d7a93-b2c6-4818-9f40-c3a1d8e6b727" id="_d8a2f0c4-7e1b-4635-9a8d-3c5e1b9f6072"/>
    <sequenceFlow sourceRef="_0e5d7a93-b2c6-4818-9f40-c3a1d8e6b727" targetRef="_f4c1e8b0-3a96-4d72-8e5b-7d2f0a9c1b48" id="_4a6e1d9b-c0f3-4782-b5a1-e9d7c2f38a06"/>
