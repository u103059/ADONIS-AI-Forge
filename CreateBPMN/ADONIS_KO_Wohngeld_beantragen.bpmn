    <startEvent name="Wohngeldbedarf entstanden" id="_e2b6d815-9f4a-4c37-8a1e-3d70b5c9f162">
      <outgoing>_5c3e8b0a-d791-4a26-8f15-b2e6a0d4c973</outgoing>
    </startEvent>

    <task name="Antrag ausfüllen" id="_47c8a3e0-6b1d-4f92-95a7-e8d2c1b40f36" isForCompensation="false">
      <documentation textFormat="text/plain">Die antragstellende Person füllt das Antragsformular auf Wohngeld aus und stellt die erforderlichen Nachweise zu Einkommen, Miete bzw. Belastung und Haushaltsmitgliedern zusammen. Ergebnis ist ein ausgefüllter Antrag mit Nachweisen.</documentation>
      <incoming>_5c3e8b0a-d791-4a26-8f15-b2e6a0d4c973</incoming>
      <outgoing>_90b4f2d6-3a1c-4e58-b7d9-6f8a1c5e0b32</outgoing>
    </task>

    <task name="Antrag einreichen" id="_b93e5d17-0a8c-4d64-b2f3-6c1a9e7d8045" isForCompensation="false">
      <documentation textFormat="text/plain">Die antragstellende Person übermittelt den ausgefüllten Antrag samt Nachweisen an die zuständige Wohngeldbehörde. Mit der Übermittlung ist der Antrag gestellt.</documentation>
      <incoming>_90b4f2d6-3a1c-4e58-b7d9-6f8a1c5e0b32</incoming>
      <outgoing>_2f8a6c1d-e5b9-4073-a4e2-9d0b7f3c1a68</outgoing>
    </task>

    <intermediateCatchEvent name="Wohngeldbescheid erhalten" id="_6f0d2a8c-e4b7-4135-9c68-a5b3d1f29e70">
      <incoming>_2f8a6c1d-e5b9-4073-a4e2-9d0b7f3c1a68</incoming>
      <outgoing>_ba1d7e43-9c06-4f2a-8e35-c4a9f0b2d617</outgoing>
      <messageEventDefinition id="messageEventDefinition_6f0d2a8c-e4b7-4135-9c68-a5b3d1f29e70"/>
    </intermediateCatchEvent>

    <intermediateCatchEvent name="Wohngeld erhalten" id="_d1a58c3f-72e9-4b06-8d14-f0c7e6a3b925">
      <incoming>_ba1d7e43-9c06-4f2a-8e35-c4a9f0b2d617</incoming>
      <outgoing>_61e9c5a8-4f2b-4d90-b3c7-a8d1e6f07245</outgoing>
      <messageEventDefinition id="messageEventDefinition_d1a58c3f-72e9-4b06-8d14-f0c7e6a3b925"/>
