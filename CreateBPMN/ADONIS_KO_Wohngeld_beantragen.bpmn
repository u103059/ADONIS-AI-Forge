<?xml version="1.0" encoding="utf-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:adonis="http://www.boc-group.com"
             xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definition__5b2e7a10-3c4d-4e5f-8a6b-7c8d9e0f0000"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             targetNamespace="http://www.boc-group.com">

  <!-- Pools: Kunde (oben), Organisation (unten, 2 Lanes) -->
  <collaboration id="Collaboration_5b2e7a10-3c4d-4e5f-8a6b-7c8d9e0f0001"
                 name="Wohngeld beantragen"
                 isClosed="false">
    <participant processRef="process_b0000001-3c4d-4e5f-8a6b-7c8d9e0f0001"
                 name="Kunde"
                 id="_a0000001-3c4d-4e5f-8a6b-7c8d9e0f0001"/>
    <participant processRef="process_b0000001-3c4d-4e5f-8a6b-7c8d9e0f0002"
                 name="Organisation"
                 id="_a0000001-3c4d-4e5f-8a6b-7c8d9e0f0002"/>

    <!-- Kunde → Organisation: Wohngeldantrag -->
    <messageFlow id="_f3000001-3c4d-4e5f-8a6b-7c8d9e0f0001"
                 name="Wohngeldantrag mit Nachweisen"
                 sourceRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0004"
                 targetRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0001">
      <extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0">
            <adonis:value>true</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0">
            <adonis:value>automatisch</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
        </adonis:connector>
      </extensionElements>
    </messageFlow>

    <!-- Organisation → Kunde: Bewilligungsbescheid -->
    <messageFlow id="_f3000001-3c4d-4e5f-8a6b-7c8d9e0f0002"
                 name="Bewilligungsbescheid"
                 sourceRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0008"
                 targetRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0005">
      <extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0">
            <adonis:value>true</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0">
            <adonis:value>automatisch</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
        </adonis:connector>
      </extensionElements>
    </messageFlow>

    <!-- Organisation → Kunde: Wohngeldzahlung -->
    <messageFlow id="_f3000001-3c4d-4e5f-8a6b-7c8d9e0f0003"
                 name="Wohngeldzahlung"
                 sourceRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0010"
                 targetRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0007">
      <extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0">
            <adonis:value>true</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0">
            <adonis:value>automatisch</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
        </adonis:connector>
      </extensionElements>
    </messageFlow>
  </collaboration>

  <!-- ===== PROZESS: Kunde ===== -->
  <process name="Kunde" id="process_b0000001-3c4d-4e5f-8a6b-7c8d9e0f0001" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_c0000001-3c4d-4e5f-8a6b-7c8d9e0f0001">
      <lane name="Antragsteller" id="_d0000001-3c4d-4e5f-8a6b-7c8d9e0f0001">
        <flowNodeRef>_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0001</flowNodeRef>
        <flowNodeRef>_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0002</flowNodeRef>
        <flowNodeRef>_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0003</flowNodeRef>
        <flowNodeRef>_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0004</flowNodeRef>
        <flowNodeRef>_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0005</flowNodeRef>
        <flowNodeRef>_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0006</flowNodeRef>
        <flowNodeRef>_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0007</flowNodeRef>
        <flowNodeRef>_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0008</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Wohnkostenzuschuss benötigt" id="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0001">
      <outgoing>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0001</outgoing>
    </startEvent>

    <task name="Wohngeldanspruch prüfen" id="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0002" isForCompensation="false">
      <documentation textFormat="text/plain">Der Antragsteller prüft anhand von Haushaltseinkommen, Anzahl der Haushaltsmitglieder und Höhe der Miete bzw. Belastung, ob ein Wohngeldanspruch in Betracht kommt. Ergebnis ist die Entscheidung, einen Wohngeldantrag zu stellen.</documentation>
      <incoming>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0001</incoming>
      <outgoing>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0002</outgoing>
    </task>

    <task name="Antragsunterlagen zusammenstellen" id="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0003" isForCompensation="false">
      <documentation textFormat="text/plain">Der Antragsteller füllt das Antragsformular aus und stellt die erforderlichen Nachweise zusammen, insbesondere Einkommensnachweise aller Haushaltsmitglieder sowie den Miet- bzw. Belastungsnachweis. Ergebnis ist ein vollständiger Antragssatz.</documentation>
      <incoming>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0002</incoming>
      <outgoing>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0003</outgoing>
    </task>

    <task name="Wohngeldantrag stellen" id="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0004" isForCompensation="false">
      <documentation textFormat="text/plain">Der Antragsteller reicht den Wohngeldantrag mit den Nachweisen bei der zuständigen Wohngeldbehörde ein. Ergebnis ist die Übermittlung des Antrags an die Organisation (Nachricht: Wohngeldantrag mit Nachweisen).</documentation>
      <incoming>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0003</incoming>
      <outgoing>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0004</outgoing>
    </task>

    <intermediateCatchEvent name="Bewilligungsbescheid erhalten" id="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0005">
      <incoming>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0004</incoming>
      <outgoing>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0005</outgoing>
      <messageEventDefinition id="messageEventDefinition_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0005"/>
    </intermediateCatchEvent>

    <task name="Bewilligungsbescheid prüfen" id="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0006" isForCompensation="false">
      <documentation textFormat="text/plain">Der Antragsteller prüft den Bewilligungsbescheid auf Bewilligungszeitraum, Höhe des Wohngelds und Rechtsbehelfsbelehrung. Ergebnis ist die Kenntnisnahme der Bewilligung.</documentation>
      <incoming>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0005</incoming>
      <outgoing>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0006</outgoing>
    </task>

    <intermediateCatchEvent name="Wohngeld eingegangen" id="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0007">
      <incoming>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0006</incoming>
      <outgoing>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0007</outgoing>
      <messageEventDefinition id="messageEventDefinition_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0007"/>
    </intermediateCatchEvent>

    <endEvent name="Wohngeld erhalten" id="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0008">
      <incoming>_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0007</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0001" targetRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0002" id="_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0001"/>
    <sequenceFlow sourceRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0002" targetRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0003" id="_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0002"/>
    <sequenceFlow sourceRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0003" targetRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0004" id="_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0003"/>
    <sequenceFlow sourceRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0004" targetRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0005" id="_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0004"/>
    <sequenceFlow sourceRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0005" targetRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0006" id="_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0005"/>
    <sequenceFlow sourceRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0006" targetRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0007" id="_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0006"/>
    <sequenceFlow sourceRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0007" targetRef="_e1000001-3c4d-4e5f-8a6b-7c8d9e0f0008" id="_f1000001-3c4d-4e5f-8a6b-7c8d9e0f0007"/>
  </process>

  <!-- ===== PROZESS: Organisation ===== -->
  <process name="Organisation" id="process_b0000001-3c4d-4e5f-8a6b-7c8d9e0f0002" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_c0000001-3c4d-4e5f-8a6b-7c8d9e0f0002">
      <lane name="Sachbearbeitung Wohngeld" id="_d0000001-3c4d-4e5f-8a6b-7c8d9e0f0002">
        <flowNodeRef>_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0001</flowNodeRef>
        <flowNodeRef>_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0002</flowNodeRef>
        <flowNodeRef>_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0003</flowNodeRef>
        <flowNodeRef>_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0004</flowNodeRef>
        <flowNodeRef>_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0005</flowNodeRef>
        <flowNodeRef>_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0006</flowNodeRef>
        <flowNodeRef>_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0007</flowNodeRef>
        <flowNodeRef>_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0008</flowNodeRef>
      </lane>
      <lane name="Zahlstelle" id="_d0000001-3c4d-4e5f-8a6b-7c8d9e0f0003">
        <flowNodeRef>_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0009</flowNodeRef>
        <flowNodeRef>_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0010</flowNodeRef>
        <flowNodeRef>_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0011</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Wohngeldantrag eingegangen" id="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0001">
      <outgoing>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0001</outgoing>
      <messageEventDefinition id="messageEventDefinition_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0001"/>
    </startEvent>

    <task name="Antrag erfassen" id="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0002" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung erfasst den eingegangenen Wohngeldantrag im Fachverfahren und vergibt ein Aktenzeichen. Ergebnis ist ein angelegter Vorgang mit den Antragsdaten.</documentation>
      <incoming>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0001</incoming>
      <outgoing>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0002</outgoing>
    </task>

    <task name="Zuständigkeit prüfen" id="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0003" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung prüft die sachliche und örtliche Zuständigkeit der Wohngeldbehörde anhand der Wohnanschrift des Antragstellers. Ergebnis ist die festgestellte Zuständigkeit.</documentation>
      <incoming>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0002</incoming>
      <outgoing>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0003</outgoing>
    </task>

    <task name="Vollständigkeit prüfen" id="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0004" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung prüft, ob Antragsformular und Nachweise (Einkommens- sowie Miet- bzw. Belastungsnachweise) vollständig vorliegen. Ergebnis ist die festgestellte Vollständigkeit der Antragsunterlagen.</documentation>
      <incoming>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0003</incoming>
      <outgoing>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0004</outgoing>
    </task>

    <task name="Anspruchsvoraussetzungen prüfen" id="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0005" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung prüft nach dem Wohngeldgesetz die Antragsberechtigung und ob ein Ausschluss durch den Bezug anderer Transferleistungen vorliegt. Ergebnis ist der festgestellte Wohngeldanspruch dem Grunde nach.</documentation>
      <incoming>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0004</incoming>
      <outgoing>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0005</outgoing>
    </task>

    <task name="Wohngeld berechnen" id="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0006" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung ermittelt Gesamteinkommen, zu berücksichtigende Miete bzw. Belastung und Anzahl der Haushaltsmitglieder und berechnet daraus den monatlichen Wohngeldbetrag sowie den Bewilligungszeitraum. Ergebnis ist der Wohngeldbetrag.</documentation>
      <incoming>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0005</incoming>
      <outgoing>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0006</outgoing>
    </task>

    <task name="Bewilligungsbescheid erstellen" id="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0007" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung erstellt den Bewilligungsbescheid mit Wohngeldbetrag, Bewilligungszeitraum, Berechnungsgrundlagen und Rechtsbehelfsbelehrung und gibt ihn frei. Ergebnis ist der freigegebene Bewilligungsbescheid.</documentation>
      <incoming>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0006</incoming>
      <outgoing>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0007</outgoing>
    </task>

    <task name="Bewilligungsbescheid versenden" id="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0008" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sachbearbeitung übermittelt den Bewilligungsbescheid an den Antragsteller (Nachricht: Bewilligungsbescheid) und gibt die Zahlung an die Zahlstelle weiter. Ergebnis ist der zugestellte Bescheid.</documentation>
      <incoming>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0007</incoming>
      <outgoing>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0008</outgoing>
    </task>

    <intermediateThrowEvent name="Zahlung angewiesen" id="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0009">
      <incoming>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0008</incoming>
      <outgoing>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0009</outgoing>
    </intermediateThrowEvent>

    <task name="Wohngeld auszahlen" id="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0010" isForCompensation="false">
      <documentation textFormat="text/plain">Die Zahlstelle überweist das bewilligte Wohngeld auf das vom Antragsteller angegebene Konto (Nachricht: Wohngeldzahlung). Ergebnis ist die ausgeführte Auszahlung.</documentation>
      <incoming>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0009</incoming>
      <outgoing>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0010</outgoing>
    </task>

    <endEvent name="Wohngeld ausgezahlt" id="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0011">
      <incoming>_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0010</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0001" targetRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0002" id="_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0001"/>
    <sequenceFlow sourceRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0002" targetRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0003" id="_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0002"/>
    <sequenceFlow sourceRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0003" targetRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0004" id="_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0003"/>
    <sequenceFlow sourceRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0004" targetRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0005" id="_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0004"/>
    <sequenceFlow sourceRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0005" targetRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0006" id="_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0005"/>
    <sequenceFlow sourceRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0006" targetRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0007" id="_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0006"/>
    <sequenceFlow sourceRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0007" targetRef="_e2000001-3c4d-4e5f-8a6b-7c8d9e0f0008" id="_f2000001-3c4d-4e5f-8a6b-7c8d9e0f0007"/>
