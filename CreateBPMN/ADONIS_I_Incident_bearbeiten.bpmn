             id="definition__17000000-0000-4000-8000-000000000000"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             targetNamespace="http://www.boc-group.com">

  <collaboration id="Collaboration_17000000-0000-4000-8000-000000000000"
                 name="Incident bearbeiten"
                 isClosed="false">
    <participant processRef="process_f6000000-0000-4000-8000-000000000000" name="Self-Service-Portal" id="_e5000000-0000-4000-8000-000000000000"/>
    <participant processRef="process_f6000000-0000-4000-8000-000000000001" name="ITSM-Ticketsystem" id="_e5000000-0000-4000-8000-000000000001"/>
    <participant processRef="process_f6000000-0000-4000-8000-000000000002" name="CMDB" id="_e5000000-0000-4000-8000-000000000002"/>
    <participant processRef="process_f6000000-0000-4000-8000-000000000003" name="Mail-Service" id="_e5000000-0000-4000-8000-000000000003"/>

    <messageFlow id="_c3000000-0000-4000-8000-000000000001" name="Incident-Meldung (REST/JSON)" sourceRef="_a1000000-0000-4000-8000-000000000003" targetRef="_a1000000-0000-4000-8000-000000000004"/>
    <messageFlow id="_c3000000-0000-4000-8000-000000000002" name="CI-Abfrage (REST/JSON)" sourceRef="_a1000000-0000-4000-8000-000000000009" targetRef="_a1000000-0000-4000-8000-000000000010"/>
    <messageFlow id="_c3000000-0000-4000-8000-000000000003" name="CI-Daten (REST/JSON)" sourceRef="_a1000000-0000-4000-8000-000000000013" targetRef="_a1000000-0000-4000-8000-000000000015"/>
    <messageFlow id="_c3000000-0000-4000-8000-000000000004" name="Benachrichtigungsauftrag (REST/JSON)" sourceRef="_a1000000-0000-4000-8000-000000000025" targetRef="_a1000000-0000-4000-8000-000000000026"/>
    <messageFlow id="_c3000000-0000-4000-8000-000000000005" name="Versandstatus (REST/JSON)" sourceRef="_a1000000-0000-4000-8000-000000000029" targetRef="_a1000000-0000-4000-8000-000000000031"/>
    <messageFlow id="_c3000000-0000-4000-8000-000000000006" name="Abschlussinformation (REST/JSON)" sourceRef="_a1000000-0000-4000-8000-000000000034" targetRef="_a1000000-0000-4000-8000-000000000036"/>
  </collaboration>

  <!-- ===== PROZESS: Self-Service-Portal ===== -->
  <process name="Self-Service-Portal" id="process_f6000000-0000-4000-8000-000000000000" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_f6000000-0000-4000-8000-000000000000">
      <lane name="Self-Service-Portal" id="_d4000000-0000-4000-8000-000000000000">
        <flowNodeRef>_a1000000-0000-4000-8000-000000000000</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000001</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000002</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000003</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000036</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000037</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000038</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Incident-Meldung erfasst" id="_a1000000-0000-4000-8000-000000000000">
      <outgoing>_b2000000-0000-4000-8000-000000000000</outgoing>
      <messageEventDefinition id="msgEvtDef_a1000000-0000-4000-8000-000000000000"/>
    </startEvent>

    <serviceTask name="Incident-Formular validieren" id="_a1000000-0000-4000-8000-000000000001" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: Self-Service-Portal, Formular-Validierung.
Input: Formulardaten des Melders (Name, Kontaktdaten, betroffener Service, Kurzbeschreibung, Fehlerbeschreibung, Dringlichkeit).
Verarbeitungslogik: Pflichtfelder und Formate (z. B. E-Mail-Adresse, Textlänge) werden geprüft. Nur valide Eingaben werden weiterverarbeitet.
Output: Validierte Formulardaten.
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000000</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000001</outgoing>
    </serviceTask>

    <scriptTask name="Incident-Meldung transformieren" id="_a1000000-0000-4000-8000-000000000002" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: Self-Service-Portal, Mapping-Komponente.
Input: Validierte Formulardaten.
Verarbeitungslogik: Die Formularfelder werden auf das JSON-Schema der Incident-Schnittstelle des Ticketsystems abgebildet. Meldezeitpunkt und Meldekanal "Portal" werden ergänzt.
Output: Incident-Meldung als JSON-Dokument.
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000001</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000002</outgoing>
    </scriptTask>

    <sendTask name="Incident-Meldung senden" id="_a1000000-0000-4000-8000-000000000003" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: Self-Service-Portal, Integrationsadapter.
Input: Incident-Meldung als JSON-Dokument.
Verarbeitungslogik: Die Meldung wird an die Incident-Schnittstelle des ITSM-Ticketsystems übermittelt.
Output: Nachricht "Incident-Meldung" an das ITSM-Ticketsystem.
Persistierung: Keine.
Schnittstelle / Protokoll: REST-API, HTTPS, JSON.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000002</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000003</outgoing>
    </sendTask>

    <receiveTask name="Abschlussinformation empfangen" id="_a1000000-0000-4000-8000-000000000036" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: Self-Service-Portal, Integrationsadapter.
Input: Abschlussinformation des ITSM-Ticketsystems (Incident-Nummer, Status, Lösungsbeschreibung) als JSON.
Verarbeitungslogik: Die Nachricht wird empfangen und dem Incident des Melders zugeordnet.
Output: Abschlussinformation zur weiteren Verarbeitung.
Persistierung: Keine.
Schnittstelle / Protokoll: REST-API, HTTPS, JSON.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000003</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000036</outgoing>
    </receiveTask>

    <serviceTask name="Incident-Status aktualisieren" id="_a1000000-0000-4000-8000-000000000037" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: Self-Service-Portal, Statusanzeige.
Input: Abschlussinformation (Incident-Nummer, Status, Lösungsbeschreibung).
Verarbeitungslogik: Der Status der Meldung wird auf "Geschlossen" gesetzt und die Lösungsbeschreibung in der Ticketübersicht des Melders bereitgestellt.
Output: Aktualisierte Statusanzeige.
Persistierung: Status der Meldung im Portal.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000036</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000037</outgoing>
    </serviceTask>

    <endEvent name="Incident-Status im Portal aktualisiert" id="_a1000000-0000-4000-8000-000000000038">
      <incoming>_b2000000-0000-4000-8000-000000000037</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_a1000000-0000-4000-8000-000000000000" targetRef="_a1000000-0000-4000-8000-000000000001" id="_b2000000-0000-4000-8000-000000000000"/>
    <sequenceFlow sourceRef="_a1000000-0000-4000-8000-000000000001" targetRef="_a1000000-0000-4000-8000-000000000002" id="_b2000000-0000-4000-8000-000000000001"/>
    <sequenceFlow sourceRef="_a1000000-0000-4000-8000-000000000002" targetRef="_a1000000-0000-4000-8000-000000000003" id="_b2000000-0000-4000-8000-000000000002"/>
    <sequenceFlow sourceRef="_a1000000-0000-4000-8000-000000000003" targetRef="_a1000000-0000-4000-8000-000000000036" id="_b2000000-0000-4000-8000-000000000003"/>
    <sequenceFlow sourceRef="_a1000000-0000-4000-8000-000000000036" targetRef="_a1000000-0000-4000-8000-000000000037" id="_b2000000-0000-4000-8000-000000000036"/>
    <sequenceFlow sourceRef="_a1000000-0000-4000-8000-000000000037" targetRef="_a1000000-0000-4000-8000-000000000038" id="_b2000000-0000-4000-8000-000000000037"/>
  </process>

  <!-- ===== PROZESS: ITSM-Ticketsystem ===== -->
  <process name="ITSM-Ticketsystem" id="process_f6000000-0000-4000-8000-000000000001" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_f6000000-0000-4000-8000-000000000001">
      <lane name="ITSM-Ticketsystem" id="_d4000000-0000-4000-8000-000000000001">
        <flowNodeRef>_a1000000-0000-4000-8000-000000000004</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000005</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000006</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000007</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000008</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000009</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000015</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000016</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000017</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000018</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000019</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000020</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000021</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000022</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000023</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000024</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000025</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000031</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000032</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000033</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000034</flowNodeRef>
        <flowNodeRef>_a1000000-0000-4000-8000-000000000035</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Incident-Meldung empfangen" id="_a1000000-0000-4000-8000-000000000004">
      <outgoing>_b2000000-0000-4000-8000-000000000004</outgoing>
      <messageEventDefinition id="msgEvtDef_a1000000-0000-4000-8000-000000000004"/>
    </startEvent>

    <serviceTask name="Incident-Daten validieren" id="_a1000000-0000-4000-8000-000000000005" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Incident-Schnittstelle.
Input: Incident-Meldung als JSON-Dokument.
Verarbeitungslogik: Das JSON-Dokument wird gegen das Schnittstellenschema geprüft; Pflichtfelder und Datenformate werden kontrolliert. Nur valide Meldungen werden weiterverarbeitet.
Output: Validierte Incident-Daten.
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000004</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000005</outgoing>
    </serviceTask>

    <scriptTask name="Incident-Nummer generieren" id="_a1000000-0000-4000-8000-000000000006" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Nummernkreis-Service.
Input: Validierte Incident-Daten.
Verarbeitungslogik: Eine eindeutige, fortlaufende Incident-Nummer wird vergeben und der Eingangszeitpunkt ergänzt.
Output: Incident-Daten mit Incident-Nummer und Eingangszeitpunkt.
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000005</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000006</outgoing>
    </scriptTask>

    <serviceTask name="Incident-Datensatz speichern" id="_a1000000-0000-4000-8000-000000000007" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Datenbank-Service.
Input: Incident-Daten mit Incident-Nummer.
Verarbeitungslogik: Der Incident-Datensatz wird mit dem Status "Neu" angelegt.
Output: Gespeicherter Incident-Datensatz.
Persistierung: Incident-Tabelle der ITSM-Datenbank.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000006</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000007</outgoing>
    </serviceTask>

    <businessRuleTask name="Incident-Kategorie ermitteln" id="_a1000000-0000-4000-8000-000000000008" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Regelwerk Kategorisierung.
Input: Betroffener Service, Kurz- und Fehlerbeschreibung.
Verarbeitungslogik: Anhand des Regelwerks werden Kategorie und Unterkategorie des Incidents bestimmt.
Output: Kategorie und Unterkategorie.
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000007</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000008</outgoing>
    </businessRuleTask>

    <sendTask name="CI-Abfrage senden" id="_a1000000-0000-4000-8000-000000000009" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Integrationsadapter.
Input: Betroffener Service, Kategorie, Incident-Nummer.
Verarbeitungslogik: Die Anfrage nach dem betroffenen Konfigurationselement wird an die CMDB übermittelt.
Output: Nachricht "CI-Abfrage" an die CMDB.
Persistierung: Keine.
Schnittstelle / Protokoll: REST-API, HTTPS, JSON.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000008</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000009</outgoing>
    </sendTask>

    <receiveTask name="CI-Daten empfangen" id="_a1000000-0000-4000-8000-000000000015" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Integrationsadapter.
Input: CI-Daten der CMDB (CI-ID, CI-Typ, Betriebsverantwortliche, abhängige Business-Services) als JSON.
Verarbeitungslogik: Die Antwort der CMDB wird empfangen und dem Incident zugeordnet.
Output: CI-Daten zur weiteren Verarbeitung.
Persistierung: Keine.
Schnittstelle / Protokoll: REST-API, HTTPS, JSON.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000009</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000015</outgoing>
    </receiveTask>

    <scriptTask name="Auswirkung berechnen" id="_a1000000-0000-4000-8000-000000000016" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Berechnungs-Skript.
Input: CI-Daten mit abhängigen Business-Services.
Verarbeitungslogik: Aus der Anzahl und Kritikalität der abhängigen Business-Services wird die Auswirkungsstufe (hoch, mittel, niedrig) berechnet.
Output: Auswirkungsstufe.
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000015</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000016</outgoing>
    </scriptTask>

    <businessRuleTask name="Priorität ermitteln" id="_a1000000-0000-4000-8000-000000000017" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Prioritätsmatrix.
Input: Auswirkungsstufe und Dringlichkeit der Meldung.
Verarbeitungslogik: Die Priorität wird nach der Prioritätsmatrix aus Auswirkung und Dringlichkeit abgeleitet.
Output: Priorität (P1 bis P4).
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000016</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000017</outgoing>
    </businessRuleTask>

    <scriptTask name="SLA-Fristen berechnen" id="_a1000000-0000-4000-8000-000000000018" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, SLA-Berechnung.
Input: Priorität und Eingangszeitpunkt.
Verarbeitungslogik: Reaktions- und Lösungsfrist werden gemäß der Vorgaben je Priorität ab dem Eingangszeitpunkt berechnet.
Output: Reaktionsfrist und Lösungsfrist.
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000017</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000018</outgoing>
    </scriptTask>

    <businessRuleTask name="Support-Gruppe zuweisen" id="_a1000000-0000-4000-8000-000000000019" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Zuweisungsregeln.
Input: Kategorie, Betriebsverantwortliche des Konfigurationselements.
Verarbeitungslogik: Anhand der Zuweisungsregeln wird die zuständige Support-Gruppe bestimmt.
Output: Zugewiesene Support-Gruppe.
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000018</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000019</outgoing>
    </businessRuleTask>

    <serviceTask name="Klassifizierungsdaten speichern" id="_a1000000-0000-4000-8000-000000000020" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Datenbank-Service.
Input: Kategorie, CI-Referenz, Priorität, SLA-Fristen, Support-Gruppe.
Verarbeitungslogik: Der Incident-Datensatz wird um die Klassifizierungsdaten ergänzt und der Status auf "Zugewiesen" gesetzt.
Output: Aktualisierter Incident-Datensatz.
Persistierung: Incident-Tabelle der ITSM-Datenbank.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000019</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000020</outgoing>
    </serviceTask>

    <userTask name="Incident analysieren und lösen" id="_a1000000-0000-4000-8000-000000000021" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Bearbeitungsoberfläche.
Input: Incident-Datensatz mit Klassifizierungs- und CI-Daten.
Verarbeitungslogik: Ein Mitarbeitender der zugewiesenen Support-Gruppe analysiert die Ursache und führt die Lösungsmaßnahme durch.
Output: Lösungsergebnis.
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000020</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000021</outgoing>
    </userTask>

    <userTask name="Lösung dokumentieren" id="_a1000000-0000-4000-8000-000000000022" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Bearbeitungsoberfläche.
Input: Lösungsergebnis der Analyse.
Verarbeitungslogik: Der Mitarbeitende erfasst Lösungsbeschreibung und Ursache im Incident-Datensatz.
Output: Dokumentierte Lösung.
Persistierung: Incident-Tabelle der ITSM-Datenbank.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000021</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000022</outgoing>
    </userTask>

    <serviceTask name="Incident-Status auf gelöst setzen" id="_a1000000-0000-4000-8000-000000000023" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Statusverwaltung.
Input: Incident-Datensatz mit dokumentierter Lösung.
Verarbeitungslogik: Der Status wird auf "Gelöst" gesetzt und der Lösungszeitpunkt erfasst.
Output: Aktualisierter Incident-Datensatz.
Persistierung: Incident-Tabelle der ITSM-Datenbank.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000022</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000023</outgoing>
    </serviceTask>

    <scriptTask name="Lösungsmitteilung generieren" id="_a1000000-0000-4000-8000-000000000024" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Benachrichtigungs-Skript.
Input: Incident-Nummer, Kontaktdaten des Melders, Lösungsbeschreibung.
Verarbeitungslogik: Die Benachrichtigungsdaten für den Melder werden zu einem Auftrag zusammengestellt.
Output: Benachrichtigungsauftrag als JSON-Dokument.
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000023</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000024</outgoing>
    </scriptTask>

    <sendTask name="Benachrichtigungsauftrag senden" id="_a1000000-0000-4000-8000-000000000025" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Integrationsadapter.
Input: Benachrichtigungsauftrag als JSON-Dokument.
Verarbeitungslogik: Der Auftrag wird an den Mail-Service übermittelt.
Output: Nachricht "Benachrichtigungsauftrag" an den Mail-Service.
Persistierung: Keine.
Schnittstelle / Protokoll: REST-API, HTTPS, JSON.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000024</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000025</outgoing>
    </sendTask>

    <receiveTask name="Versandstatus empfangen" id="_a1000000-0000-4000-8000-000000000031" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Integrationsadapter.
Input: Versandstatus des Mail-Service als JSON.
Verarbeitungslogik: Die Versandbestätigung wird empfangen und dem Incident zugeordnet.
Output: Versandstatus zur weiteren Verarbeitung.
Persistierung: Keine.
Schnittstelle / Protokoll: REST-API, HTTPS, JSON.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000025</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000031</outgoing>
    </receiveTask>

    <serviceTask name="Incident schließen" id="_a1000000-0000-4000-8000-000000000032" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Statusverwaltung.
Input: Incident-Datensatz mit bestätigtem Versandstatus.
Verarbeitungslogik: Der Status wird auf "Geschlossen" gesetzt und der Abschlusszeitpunkt erfasst.
Output: Geschlossener Incident-Datensatz.
Persistierung: Incident-Tabelle der ITSM-Datenbank.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000031</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000032</outgoing>
    </serviceTask>

    <serviceTask name="Incident-Protokoll speichern" id="_a1000000-0000-4000-8000-000000000033" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Protokollierungs-Service.
Input: Statuswechsel und Zeitstempel des Incidents.
Verarbeitungslogik: Der Bearbeitungsverlauf des Incidents wird als Protokoll abgelegt.
Output: Gespeichertes Incident-Protokoll.
Persistierung: Protokolltabelle der ITSM-Datenbank.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000032</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000033</outgoing>
    </serviceTask>

    <sendTask name="Abschlussinformation senden" id="_a1000000-0000-4000-8000-000000000034" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: ITSM-Ticketsystem, Integrationsadapter.
Input: Incident-Nummer, Status, Lösungsbeschreibung.
Verarbeitungslogik: Die Abschlussinformation wird an das Self-Service-Portal übermittelt.
Output: Nachricht "Abschlussinformation" an das Self-Service-Portal.
Persistierung: Keine.
Schnittstelle / Protokoll: REST-API, HTTPS, JSON.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000033</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000034</outgoing>
    </sendTask>

    <endEvent name="Incident abgeschlossen" id="_a1000000-0000-4000-8000-000000000035">
