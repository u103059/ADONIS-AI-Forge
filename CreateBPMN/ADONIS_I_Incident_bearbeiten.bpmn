    <serviceTask name="Konfigurationselement ermitteln" id="_a1000000-0000-4000-8000-000000000011" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: CMDB, Abfrage-Service.
Input: Betroffener Service und Kategorie aus der CI-Abfrage.
Verarbeitungslogik: Das zum betroffenen Service gehörende Konfigurationselement (CI) wird in der CMDB gesucht.
Output: CI-ID, CI-Typ und Betriebsverantwortliche.
Persistierung: Keine (lesender Zugriff auf die CMDB-Datenbank).</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000010</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000011</outgoing>
    </serviceTask>

    <serviceTask name="Abhängige Business-Services abrufen" id="_a1000000-0000-4000-8000-000000000012" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: CMDB, Relationen-Service.
Input: CI-ID des Konfigurationselements.
Verarbeitungslogik: Die Beziehungen des CI zu Business-Services werden abgerufen.
Output: Liste abhängiger Business-Services.
Persistierung: Keine (lesender Zugriff auf die CMDB-Datenbank).</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000011</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000012</outgoing>
    </serviceTask>

    <sendTask name="CI-Daten senden" id="_a1000000-0000-4000-8000-000000000013" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: CMDB, Integrationsadapter.
Input: CI-ID, CI-Typ, Betriebsverantwortliche, abhängige Business-Services.
Verarbeitungslogik: Die CI-Daten werden als Antwort an das ITSM-Ticketsystem übermittelt.
Output: Nachricht "CI-Daten" an das ITSM-Ticketsystem.
Persistierung: Keine.
Schnittstelle / Protokoll: REST-API, HTTPS, JSON.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000012</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000013</outgoing>
    </sendTask>

    <endEvent name="CI-Daten bereitgestellt" id="_a1000000-0000-4000-8000-000000000014">
      <incoming>_b2000000-0000-4000-8000-000000000013</incoming>
    </endEvent>

