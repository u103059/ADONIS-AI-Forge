    <scriptTask name="E-Mail-Vorlage generieren" id="_a1000000-0000-4000-8000-000000000027" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: Mail-Service, Template-Engine.
Input: Benachrichtigungsauftrag (Incident-Nummer, Empfänger, Lösungsbeschreibung).
Verarbeitungslogik: Die Vorlage für die Lösungsmitteilung wird mit den Daten des Auftrags befüllt.
Output: Versandfertige E-Mail.
Persistierung: Keine.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000026</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000027</outgoing>
    </scriptTask>

    <serviceTask name="E-Mail versenden" id="_a1000000-0000-4000-8000-000000000028" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: Mail-Service, SMTP-Versand.
Input: Versandfertige E-Mail.
Verarbeitungslogik: Die Lösungsmitteilung wird an die E-Mail-Adresse des Melders versendet.
Output: Versandstatus.
Persistierung: Keine.
Schnittstelle / Protokoll: SMTP.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000027</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000028</outgoing>
    </serviceTask>

    <sendTask name="Versandstatus senden" id="_a1000000-0000-4000-8000-000000000029" isForCompensation="false">
      <documentation textFormat="text/plain">System / Komponente: Mail-Service, Integrationsadapter.
Input: Versandstatus und Incident-Nummer.
Verarbeitungslogik: Die Versandbestätigung wird an das ITSM-Ticketsystem zurückgemeldet.
Output: Nachricht "Versandstatus" an das ITSM-Ticketsystem.
Persistierung: Keine.
Schnittstelle / Protokoll: REST-API, HTTPS, JSON.</documentation>
      <incoming>_b2000000-0000-4000-8000-000000000028</incoming>
      <outgoing>_b2000000-0000-4000-8000-000000000029</outgoing>
    </sendTask>

    <endEvent name="Benachrichtigung versendet" id="_a1000000-0000-4000-8000-000000000030">
