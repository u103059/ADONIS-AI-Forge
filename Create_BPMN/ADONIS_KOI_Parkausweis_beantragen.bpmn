             id="definition__6d7d6ff8-2d85-4f8a-8ef0-86a6bb8f6ef2"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             targetNamespace="http://www.boc-group.com">

  <collaboration id="Collaboration_6d7d6ff8-2d85-4f8a-8ef0-86a6bb8f6ef2"
                 name="Parkausweis beantragen"
                 isClosed="false">
    <participant processRef="process_50d2bff8-a7a3-4da0-b747-2de6f7cc4f95" name="Kunde" id="_3c8a4f99-7bf5-4d9f-a0d5-f7829242ccbb"/>
    <participant processRef="process_6af72e36-a420-4300-b90b-a0fa6d0d96e5" name="IT" id="_92842bf4-2e9a-4c49-985e-0df6812f46f5"/>
    <participant processRef="process_53e08c83-4e9b-42a8-b538-9c78875f9f81" name="Organisation" id="_bb708d2d-13d1-4215-a6d5-84e4ef98b1bd"/>

    <messageFlow id="_42d86b0d-8719-4ef6-a51d-4df13f5915ef" name="Antrag" sourceRef="_kunde_task_submit" targetRef="_org_start"/>
    <messageFlow id="_d89e7d00-4bf0-4d97-a4b5-15cb9a2fe12d" name="Datenanfrage" sourceRef="_org_task_request" targetRef="_it_start"/>
    <messageFlow id="_6167d693-f0ef-41a8-bf3d-c9768d32e79d" name="Datenvalidierung" sourceRef="_it_task_validate" targetRef="_org_task_issue"/>
    <messageFlow id="_25fd7408-a7a5-4e6d-9d35-5e36dbaa2a0d" name="Bescheid" sourceRef="_org_task_issue" targetRef="_kunde_task_receive"/>
  </collaboration>

  <process name="Kunde" id="process_50d2bff8-a7a3-4da0-b747-2de6f7cc4f95" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_50d2bff8-a7a3-4da0-b747-2de6f7cc4f95">
      <lane name="Kunde" id="_da3bd1a3-dccd-4a9f-bd9a-7835f1cdb4d9">
        <flowNodeRef>_kunde_start</flowNodeRef>
        <flowNodeRef>_kunde_task_prepare</flowNodeRef>
        <flowNodeRef>_kunde_task_submit</flowNodeRef>
        <flowNodeRef>_kunde_task_receive</flowNodeRef>
        <flowNodeRef>_kunde_end</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Antrag gestartet" id="_kunde_start">
      <outgoing>_kunde_flow_1</outgoing>
    </startEvent>

    <task name="Antrag vorbereiten" id="_kunde_task_prepare" isForCompensation="false">
      <documentation textFormat="text/plain">Der Kunde sammelt die notwendigen Angaben zum Parkausweis, prüft die benötigten Nachweise und bereitet die digitale Einreichung vor.</documentation>
      <incoming>_kunde_flow_1</incoming>
      <outgoing>_kunde_flow_2</outgoing>
    </task>

    <task name="Antrag einreichen" id="_kunde_task_submit" isForCompensation="false">
      <documentation textFormat="text/plain">Der Kunde übermittelt den vollständig ausgefüllten Antrag und die erforderlichen Angaben an die Organisation über das digitale Antragsportal.</documentation>
      <incoming>_kunde_flow_2</incoming>
      <outgoing>_kunde_flow_3</outgoing>
    </task>

    <task name="Bescheid entgegennehmen" id="_kunde_task_receive" isForCompensation="false">
      <documentation textFormat="text/plain">Der Kunde erhält die Nachricht zur Entscheidung der Organisation und nimmt den Bescheid für den Parkausweis entgegen.</documentation>
      <incoming>_kunde_flow_3</incoming>
      <outgoing>_kunde_flow_4</outgoing>
    </task>

    <endEvent name="Antrag abgeschlossen" id="_kunde_end">
      <incoming>_kunde_flow_4</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_kunde_start" targetRef="_kunde_task_prepare" id="_kunde_flow_1"/>
    <sequenceFlow sourceRef="_kunde_task_prepare" targetRef="_kunde_task_submit" id="_kunde_flow_2"/>
    <sequenceFlow sourceRef="_kunde_task_submit" targetRef="_kunde_task_receive" id="_kunde_flow_3"/>
    <sequenceFlow sourceRef="_kunde_task_receive" targetRef="_kunde_end" id="_kunde_flow_4"/>
  </process>

  <process name="IT" id="process_6af72e36-a420-4300-b90b-a0fa6d0d96e5" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_6af72e36-a420-4300-b90b-a0fa6d0d96e5">
      <lane name="IT" id="_2ede5bb0-56ec-4479-b266-2d5325574cd9">
        <flowNodeRef>_it_start</flowNodeRef>
        <flowNodeRef>_it_task_validate</flowNodeRef>
        <flowNodeRef>_it_end</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Datenanfrage eingegangen" id="_it_start">
      <outgoing>_it_flow_1</outgoing>
      <messageEventDefinition id="msgEvtDef_it_start"/>
    </startEvent>

    <task name="Daten validieren" id="_it_task_validate" isForCompensation="false">
      <documentation textFormat="text/plain">Die IT prüft die übermittelten Antragsdaten, kontrolliert die Vollständigkeit und bereitet die fachliche Weiterverarbeitung für die Organisation vor.</documentation>
      <incoming>_it_flow_1</incoming>
      <outgoing>_it_flow_2</outgoing>
    </task>

    <endEvent name="Daten freigegeben" id="_it_end">
      <incoming>_it_flow_2</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_it_start" targetRef="_it_task_validate" id="_it_flow_1"/>
    <sequenceFlow sourceRef="_it_task_validate" targetRef="_it_end" id="_it_flow_2"/>
  </process>

  <process name="Organisation" id="process_53e08c83-4e9b-42a8-b538-9c78875f9f81" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_53e08c83-4e9b-42a8-b538-9c78875f9f81">
      <lane name="Organisation" id="_8c1802a8-3e1c-4094-b0d6-14e325f63850">
        <flowNodeRef>_org_start</flowNodeRef>
        <flowNodeRef>_org_task_check</flowNodeRef>
        <flowNodeRef>_org_task_request</flowNodeRef>
        <flowNodeRef>_org_task_issue</flowNodeRef>
        <flowNodeRef>_org_end</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Antrag eingegangen" id="_org_start">
      <outgoing>_org_flow_1</outgoing>
      <messageEventDefinition id="msgEvtDef_org_start"/>
    </startEvent>

    <task name="Antrag prüfen" id="_org_task_check" isForCompensation="false">
      <documentation textFormat="text/plain">Die Organisation prüft den eingegangenen Antrag und verifiziert die vom Kunden angegebenen Voraussetzungen und Nachweise für den Parkausweis.</documentation>
      <incoming>_org_flow_1</incoming>
      <outgoing>_org_flow_2</outgoing>
    </task>

    <task name="Datenanfrage senden" id="_org_task_request" isForCompensation="false">
      <documentation textFormat="text/plain">Die Organisation fordert bei der IT die zusätzlichen Prüf- und Validierungsdaten an, damit die fachliche Entscheidung auf vollständigen Informationen basiert.</documentation>
      <incoming>_org_flow_2</incoming>
      <outgoing>_org_flow_3</outgoing>
    </task>

    <task name="Parkausweis ausstellen" id="_org_task_issue" isForCompensation="false">
      <documentation textFormat="text/plain">Nach erfolgreicher Prüfung und Rückmeldung der IT stellt die Organisation den Parkausweis aus und dokumentiert die Entscheidung für den Kunden.</documentation>
      <incoming>_org_flow_3</incoming>
      <outgoing>_org_flow_5</outgoing>
    </task>

    <endEvent name="Bescheid erteilt" id="_org_end">
      <incoming>_org_flow_5</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_org_start" targetRef="_org_task_check" id="_org_flow_1"/>
    <sequenceFlow sourceRef="_org_task_check" targetRef="_org_task_request" id="_org_flow_2"/>
    <sequenceFlow sourceRef="_org_task_request" targetRef="_org_task_issue" id="_org_flow_3"/>
    <sequenceFlow sourceRef="_org_task_issue" targetRef="_org_end" id="_org_flow_5"/>
  </process>

