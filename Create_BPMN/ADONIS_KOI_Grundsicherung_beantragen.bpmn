             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             targetNamespace="http://www.boc-group.com">

  <collaboration id="Collaboration_f7d83c9a-2d51-4b57-9ae4-7f9a9ec2c0a2"
                 name="Grundsicherung beantragen"
                 isClosed="false">
    <participant processRef="process_8fb2bb43-fd50-4c8e-8384-863cb3ee10cb" name="Kunde" id="_d437f201-9f0d-4c54-a139-01d2d7bf7b36"/>
    <participant processRef="process_0f479eb4-2cba-4f6a-b0e5-b7c5718a4961" name="IT" id="_b6f86d3e-1be2-4a65-9f1d-6c426f0d96cc"/>
    <participant processRef="process_9b2be7a8-92d7-4f4b-9b35-8ab7b3d3580d" name="Organisation" id="_6d23d52d-0f0d-4bbc-93ae-650505640b78"/>

    <messageFlow id="_8254c66a-7303-4eb6-aef4-ed3a663fd9b7" name="Antrag" sourceRef="_kunde_task_submit" targetRef="_org_start"/>
    <messageFlow id="_795e7605-6d42-4aa1-9c2d-cfde6a5d4e39" name="Datenanfrage" sourceRef="_org_task_request" targetRef="_it_start"/>
    <messageFlow id="_4d3d67d5-4b36-4207-8955-7dd5062fdd60" name="Datenantwort" sourceRef="_it_task_provide" targetRef="_org_task_assess"/>
    <messageFlow id="_7ca5d17f-1786-42be-b3bb-75d0d8c804a8" name="Bescheid" sourceRef="_org_task_issue" targetRef="_kunde_task_receive"/>
  </collaboration>

  <process name="Kunde" id="process_8fb2bb43-fd50-4c8e-8384-863cb3ee10cb" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_8fb2bb43-fd50-4c8e-8384-863cb3ee10cb">
      <lane name="Kunde" id="_1a8f807d-2fc6-4bd9-99fa-6d2991cb3c48">
        <flowNodeRef>_kunde_start</flowNodeRef>
        <flowNodeRef>_kunde_task_prepare</flowNodeRef>
        <flowNodeRef>_kunde_task_submit</flowNodeRef>
        <flowNodeRef>_kunde_task_reply</flowNodeRef>
        <flowNodeRef>_kunde_task_receive</flowNodeRef>
        <flowNodeRef>_kunde_end</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Antrag gestartet" id="_kunde_start">
      <outgoing>_kunde_flow_1</outgoing>
    </startEvent>

    <task name="Antrag vorbereiten" id="_kunde_task_prepare" isForCompensation="false">
      <documentation textFormat="text/plain">Der Kunde sammelt die für die Grundsicherung relevanten Angaben, prüft die benötigten Nachweise und bereitet die digitale Antragstellung vor.</documentation>
      <incoming>_kunde_flow_1</incoming>
      <outgoing>_kunde_flow_2</outgoing>
    </task>

    <task name="Antrag einreichen" id="_kunde_task_submit" isForCompensation="false">
      <documentation textFormat="text/plain">Der Kunde reicht den vollständig ausgefüllten Antrag auf Grundsicherung bei der zuständigen Organisation ein und übermittelt die erforderlichen Angaben.</documentation>
      <incoming>_kunde_flow_2</incoming>
      <outgoing>_kunde_flow_3</outgoing>
    </task>

    <task name="Rückfrage beantworten" id="_kunde_task_reply" isForCompensation="false">
      <documentation textFormat="text/plain">Der Kunde beantwortet nach Bedarf Rückfragen der Organisation und ergänzt fehlende oder unklare Informationen für die Prüfung des Leistungsanspruchs.</documentation>
      <incoming>_kunde_flow_3</incoming>
      <outgoing>_kunde_flow_4</outgoing>
    </task>

    <task name="Bescheid entgegennehmen" id="_kunde_task_receive" isForCompensation="false">
      <documentation textFormat="text/plain">Der Kunde erhält den Bescheid zur Entscheidung über die Grundsicherung und nimmt die Mitteilung der Organisation entgegen.</documentation>
      <incoming>_kunde_flow_4</incoming>
      <outgoing>_kunde_flow_5</outgoing>
    </task>

    <endEvent name="Antrag bearbeitet" id="_kunde_end">
      <incoming>_kunde_flow_5</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_kunde_start" targetRef="_kunde_task_prepare" id="_kunde_flow_1"/>
    <sequenceFlow sourceRef="_kunde_task_prepare" targetRef="_kunde_task_submit" id="_kunde_flow_2"/>
    <sequenceFlow sourceRef="_kunde_task_submit" targetRef="_kunde_task_reply" id="_kunde_flow_3"/>
    <sequenceFlow sourceRef="_kunde_task_reply" targetRef="_kunde_task_receive" id="_kunde_flow_4"/>
    <sequenceFlow sourceRef="_kunde_task_receive" targetRef="_kunde_end" id="_kunde_flow_5"/>
  </process>

  <process name="IT" id="process_0f479eb4-2cba-4f6a-b0e5-b7c5718a4961" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_0f479eb4-2cba-4f6a-b0e5-b7c5718a4961">
      <lane name="IT" id="_8e1dc6b5-b803-4ecf-9fe0-f8d43d1c2174">
        <flowNodeRef>_it_start</flowNodeRef>
        <flowNodeRef>_it_task_process</flowNodeRef>
        <flowNodeRef>_it_task_validate</flowNodeRef>
        <flowNodeRef>_it_task_provide</flowNodeRef>
        <flowNodeRef>_it_end</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Datenanfrage eingegangen" id="_it_start">
      <outgoing>_it_flow_1</outgoing>
      <messageEventDefinition id="msgEvtDef_it_start"/>
    </startEvent>

    <task name="Datenabfrage verarbeiten" id="_it_task_process" isForCompensation="false">
      <documentation textFormat="text/plain">Die IT verarbeitet die von der Organisation angeforderten Daten, öffnet die relevanten Informationssysteme und bereitet die Prüfung für die Grundsicherung vor.</documentation>
      <incoming>_it_flow_1</incoming>
      <outgoing>_it_flow_2</outgoing>
    </task>

    <task name="Daten validieren" id="_it_task_validate" isForCompensation="false">
      <documentation textFormat="text/plain">Die IT prüft die Vollständigkeit, Konsistenz und fachliche Plausibilität der übermittelten Daten für die Bewertung des Leistungsanspruchs.</documentation>
      <incoming>_it_flow_2</incoming>
      <outgoing>_it_flow_3</outgoing>
    </task>

    <task name="Ergebnis bereitstellen" id="_it_task_provide" isForCompensation="false">
      <documentation textFormat="text/plain">Die IT liefert der Organisation die validierten Daten und das Prüfergebnis, damit die fachliche Entscheidung über die Grundsicherung getroffen werden kann.</documentation>
      <incoming>_it_flow_3</incoming>
      <outgoing>_it_flow_4</outgoing>
    </task>

    <endEvent name="Daten bearbeitet" id="_it_end">
      <incoming>_it_flow_4</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_it_start" targetRef="_it_task_process" id="_it_flow_1"/>
    <sequenceFlow sourceRef="_it_task_process" targetRef="_it_task_validate" id="_it_flow_2"/>
    <sequenceFlow sourceRef="_it_task_validate" targetRef="_it_task_provide" id="_it_flow_3"/>
    <sequenceFlow sourceRef="_it_task_provide" targetRef="_it_end" id="_it_flow_4"/>
  </process>

  <process name="Organisation" id="process_9b2be7a8-92d7-4f4b-9b35-8ab7b3d3580d" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_9b2be7a8-92d7-4f4b-9b35-8ab7b3d3580d">
      <lane name="Organisation" id="_7d6f8f3a-bca4-4e75-94b7-0f79a7fe9eb7">
        <flowNodeRef>_org_start</flowNodeRef>
        <flowNodeRef>_org_task_check</flowNodeRef>
        <flowNodeRef>_org_task_request</flowNodeRef>
        <flowNodeRef>_org_task_assess</flowNodeRef>
        <flowNodeRef>_org_task_issue</flowNodeRef>
        <flowNodeRef>_org_end</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Antrag eingegangen" id="_org_start">
      <outgoing>_org_flow_1</outgoing>
      <messageEventDefinition id="msgEvtDef_org_start"/>
    </startEvent>

    <task name="Antrag prüfen" id="_org_task_check" isForCompensation="false">
      <documentation textFormat="text/plain">Die Organisation prüft den eingegangenen Antrag auf Vollständigkeit, Identität und grundlegende Voraussetzungen für die Gewährung von Grundsicherung.</documentation>
      <incoming>_org_flow_1</incoming>
      <outgoing>_org_flow_2</outgoing>
    </task>

    <task name="Datenanfrage senden" id="_org_task_request" isForCompensation="false">
      <documentation textFormat="text/plain">Die Organisation fordert die für die Leistungsprüfung erforderlichen Daten und Nachweise bei der IT an, damit die sachliche Bewertung verlässlicher erfolgen kann.</documentation>
      <incoming>_org_flow_2</incoming>
      <outgoing>_org_flow_3</outgoing>
    </task>

    <task name="Bedarf bewerten" id="_org_task_assess" isForCompensation="false">
      <documentation textFormat="text/plain">Nach Eingang der validierten Daten bewertet die Organisation den individuellen Bedarf und prüft, ob die Voraussetzungen für die Gewährung der Grundsicherung erfüllt sind.</documentation>
      <incoming>_org_flow_3</incoming>
      <outgoing>_org_flow_4</outgoing>
    </task>

    <task name="Bescheid erstellen" id="_org_task_issue" isForCompensation="false">
      <documentation textFormat="text/plain">Die Organisation erstellt den Bescheid zur Gewährung oder Ablehnung der Grundsicherung und dokumentiert die einschlägigen Entscheidungskriterien.</documentation>
      <incoming>_org_flow_4</incoming>
      <outgoing>_org_flow_5</outgoing>
    </task>

    <endEvent name="Bescheid erteilt" id="_org_end">
      <incoming>_org_flow_5</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_org_start" targetRef="_org_task_check" id="_org_flow_1"/>
    <sequenceFlow sourceRef="_org_task_check" targetRef="_org_task_request" id="_org_flow_2"/>
    <sequenceFlow sourceRef="_org_task_request" targetRef="_org_task_assess" id="_org_flow_3"/>
    <sequenceFlow sourceRef="_org_task_assess" targetRef="_org_task_issue" id="_org_flow_4"/>
    <sequenceFlow sourceRef="_org_task_issue" targetRef="_org_end" id="_org_flow_5"/>
  </process>

