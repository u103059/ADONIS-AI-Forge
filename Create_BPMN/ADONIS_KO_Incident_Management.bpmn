<?xml version="1.0" encoding="utf-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:adonis="http://www.boc-group.com"
             xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definition__8c1d2e30-4a5b-4c6d-8e7f-9a0b1c2d0000"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             targetNamespace="http://www.boc-group.com">

  <!-- Pools: Kunde (oben), Organisation (unten, 2 Lanes: Service Desk, Fachteam) -->
  <collaboration id="Collaboration_8c1d2e30-4a5b-4c6d-8e7f-9a0b1c2d0001"
                 name="Incident Management"
                 isClosed="false">
    <participant processRef="process_b0000002-4a5b-4c6d-8e7f-9a0b1c2d0001"
                 name="Kunde"
                 id="_a0000002-4a5b-4c6d-8e7f-9a0b1c2d0001"/>
    <participant processRef="process_b0000002-4a5b-4c6d-8e7f-9a0b1c2d0002"
                 name="Organisation"
                 id="_a0000002-4a5b-4c6d-8e7f-9a0b1c2d0002"/>

    <!-- Kunde → Organisation: Störungsmeldung -->
    <messageFlow id="_f3000002-4a5b-4c6d-8e7f-9a0b1c2d0001"
                 name="Störungsmeldung"
                 sourceRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0002"
                 targetRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0001">
      <extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0">
            <adonis:value>true</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0">
            <adonis:value>automatisch</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
        </adonis:connector>
      </extensionElements>
    </messageFlow>

    <!-- Organisation → Kunde: Eingangsbestätigung -->
    <messageFlow id="_f3000002-4a5b-4c6d-8e7f-9a0b1c2d0002"
                 name="Eingangsbestätigung mit Ticketnummer"
                 sourceRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0003"
                 targetRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0003">
      <extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0">
            <adonis:value>true</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0">
            <adonis:value>automatisch</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
        </adonis:connector>
      </extensionElements>
    </messageFlow>

    <!-- Organisation → Kunde: Lösungsmitteilung -->
    <messageFlow id="_f3000002-4a5b-4c6d-8e7f-9a0b1c2d0003"
                 name="Lösungsmitteilung"
                 sourceRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0012"
                 targetRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0004">
      <extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0">
            <adonis:value>true</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0">
            <adonis:value>automatisch</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
        </adonis:connector>
      </extensionElements>
    </messageFlow>

    <!-- Kunde → Organisation: Bestätigung -->
    <messageFlow id="_f3000002-4a5b-4c6d-8e7f-9a0b1c2d0004"
                 name="Bestätigung der Wiederherstellung"
                 sourceRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0005"
                 targetRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0013">
      <extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0">
            <adonis:value>true</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0">
            <adonis:value>automatisch</adonis:value>
            <adonis:metavalue/>
          </adonis:attribute>
        </adonis:connector>
      </extensionElements>
    </messageFlow>
  </collaboration>

  <!-- ===== PROZESS: Kunde ===== -->
  <process name="Kunde" id="process_b0000002-4a5b-4c6d-8e7f-9a0b1c2d0001" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_c0000002-4a5b-4c6d-8e7f-9a0b1c2d0001">
      <lane name="Anwender" id="_d0000002-4a5b-4c6d-8e7f-9a0b1c2d0001">
        <flowNodeRef>_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0001</flowNodeRef>
        <flowNodeRef>_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0002</flowNodeRef>
        <flowNodeRef>_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0003</flowNodeRef>
        <flowNodeRef>_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0004</flowNodeRef>
        <flowNodeRef>_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0005</flowNodeRef>
        <flowNodeRef>_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0006</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Störung festgestellt" id="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0001">
      <outgoing>_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0001</outgoing>
    </startEvent>

    <task name="Störung melden" id="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0002" isForCompensation="false">
      <documentation textFormat="text/plain">Der Anwender meldet die festgestellte Störung des IT-Services beim Service Desk und beschreibt Symptome und Auswirkung. Ergebnis ist die Übermittlung der Störungsmeldung an die Organisation (Nachricht: Störungsmeldung).</documentation>
      <incoming>_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0001</incoming>
      <outgoing>_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0002</outgoing>
    </task>

    <intermediateCatchEvent name="Eingangsbestätigung erhalten" id="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0003">
      <incoming>_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0002</incoming>
      <outgoing>_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0003</outgoing>
      <messageEventDefinition id="messageEventDefinition_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0003"/>
    </intermediateCatchEvent>

    <intermediateCatchEvent name="Lösungsmitteilung erhalten" id="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0004">
      <incoming>_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0003</incoming>
      <outgoing>_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0004</outgoing>
      <messageEventDefinition id="messageEventDefinition_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0004"/>
    </intermediateCatchEvent>

    <task name="Lösung bestätigen" id="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0005" isForCompensation="false">
      <documentation textFormat="text/plain">Der Anwender prüft anhand der Lösungsmitteilung, ob der gestörte IT-Service wieder wie gewohnt nutzbar ist, und bestätigt dies gegenüber dem Service Desk. Ergebnis ist die Bestätigung der Wiederherstellung (Nachricht: Bestätigung der Wiederherstellung).</documentation>
      <incoming>_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0004</incoming>
      <outgoing>_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0005</outgoing>
    </task>

    <endEvent name="Service wiederhergestellt" id="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0006">
      <incoming>_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0005</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0001" targetRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0002" id="_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0001"/>
    <sequenceFlow sourceRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0002" targetRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0003" id="_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0002"/>
    <sequenceFlow sourceRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0003" targetRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0004" id="_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0003"/>
    <sequenceFlow sourceRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0004" targetRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0005" id="_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0004"/>
    <sequenceFlow sourceRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0005" targetRef="_e1000002-4a5b-4c6d-8e7f-9a0b1c2d0006" id="_f1000002-4a5b-4c6d-8e7f-9a0b1c2d0005"/>
  </process>

  <!-- ===== PROZESS: Organisation ===== -->
  <process name="Organisation" id="process_b0000002-4a5b-4c6d-8e7f-9a0b1c2d0002" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_c0000002-4a5b-4c6d-8e7f-9a0b1c2d0002">
      <lane name="Service Desk" id="_d0000002-4a5b-4c6d-8e7f-9a0b1c2d0002">
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0001</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0002</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0003</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0004</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0005</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0006</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0011</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0012</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0013</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0014</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0015</flowNodeRef>
      </lane>
      <lane name="Fachteam" id="_d0000002-4a5b-4c6d-8e7f-9a0b1c2d0003">
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0007</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0008</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0009</flowNodeRef>
        <flowNodeRef>_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0010</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Störungsmeldung eingegangen" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0001">
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0001</outgoing>
      <messageEventDefinition id="messageEventDefinition_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0001"/>
    </startEvent>

    <task name="Incident erfassen" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0002" isForCompensation="false">
      <documentation textFormat="text/plain">Der Service Desk legt zur eingegangenen Störungsmeldung ein Incident-Ticket an und erfasst Beschreibung, betroffenen Anwender und betroffenen Service. Ergebnis ist ein angelegtes Ticket mit Ticketnummer.</documentation>
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0001</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0002</outgoing>
    </task>

    <task name="Eingangsbestätigung versenden" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0003" isForCompensation="false">
      <documentation textFormat="text/plain">Der Service Desk bestätigt dem Anwender den Eingang der Störungsmeldung und teilt die Ticketnummer mit. Ergebnis ist die Information des Anwenders über den Bearbeitungsstart (Nachricht: Eingangsbestätigung mit Ticketnummer).</documentation>
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0002</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0003</outgoing>
    </task>

    <task name="Incident kategorisieren und priorisieren" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0004" isForCompensation="false">
      <documentation textFormat="text/plain">Der Service Desk ordnet das Incident-Ticket einer Kategorie zu und bestimmt anhand von Auswirkung und Dringlichkeit die Priorität. Ergebnis ist ein kategorisiertes und priorisiertes Ticket.</documentation>
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0003</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0004</outgoing>
    </task>

    <task name="Erstanalyse durchführen" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0005" isForCompensation="false">
      <documentation textFormat="text/plain">Der Service Desk gleicht die Störung mit bekannten Fehlern und der Lösungsdatenbank ab und prüft, ob eine Lösung im Rahmen der Ersten Ebene möglich ist. Ergebnis ist die Feststellung, dass das Fachteam hinzugezogen werden muss.</documentation>
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0004</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0005</outgoing>
    </task>

    <task name="Incident an Fachteam übergeben" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0006" isForCompensation="false">
      <documentation textFormat="text/plain">Der Service Desk weist das Incident-Ticket mit den Ergebnissen der Erstanalyse dem zuständigen Fachteam zu. Ergebnis ist ein dem Fachteam zugewiesenes Ticket.</documentation>
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0005</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0006</outgoing>
    </task>

    <intermediateThrowEvent name="Incident übernommen" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0007">
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0006</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0007</outgoing>
    </intermediateThrowEvent>

    <task name="Ursache diagnostizieren" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0008" isForCompensation="false">
      <documentation textFormat="text/plain">Das Fachteam analysiert die Störung technisch und ermittelt die Ursache anhand der Ticketangaben. Ergebnis ist die festgestellte Störungsursache.</documentation>
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0007</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0008</outgoing>
    </task>

    <task name="Störung beheben" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0009" isForCompensation="false">
      <documentation textFormat="text/plain">Das Fachteam setzt die Lösung oder einen Workaround um und stellt den gestörten IT-Service wieder her. Ergebnis ist ein wieder funktionsfähiger Service.</documentation>
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0008</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0009</outgoing>
    </task>

    <task name="Lösung dokumentieren" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0010" isForCompensation="false">
      <documentation textFormat="text/plain">Das Fachteam hält Ursache und durchgeführte Maßnahmen im Incident-Ticket fest. Ergebnis ist ein vollständig dokumentiertes Ticket.</documentation>
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0009</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0010</outgoing>
    </task>

    <intermediateThrowEvent name="Lösung bereitgestellt" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0011">
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0010</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0011</outgoing>
    </intermediateThrowEvent>

    <task name="Lösung mitteilen" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0012" isForCompensation="false">
      <documentation textFormat="text/plain">Der Service Desk informiert den Anwender über die Behebung der Störung und bittet um Bestätigung der Wiederherstellung. Ergebnis ist die Information des Anwenders (Nachricht: Lösungsmitteilung).</documentation>
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0011</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0012</outgoing>
    </task>

    <intermediateCatchEvent name="Bestätigung erhalten" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0013">
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0012</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0013</outgoing>
      <messageEventDefinition id="messageEventDefinition_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0013"/>
    </intermediateCatchEvent>

    <task name="Incident schließen" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0014" isForCompensation="false">
      <documentation textFormat="text/plain">Der Service Desk schließt das Incident-Ticket nach der Bestätigung des Anwenders ab. Ergebnis ist ein geschlossenes Ticket.</documentation>
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0013</incoming>
      <outgoing>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0014</outgoing>
    </task>

    <endEvent name="Incident abgeschlossen" id="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0015">
      <incoming>_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0014</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0001" targetRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0002" id="_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0001"/>
    <sequenceFlow sourceRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0002" targetRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0003" id="_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0002"/>
    <sequenceFlow sourceRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0003" targetRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0004" id="_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0003"/>
    <sequenceFlow sourceRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0004" targetRef="_e2000002-4a5b-4c6d-8e7f-9a0b1c2d0005" id="_f2000002-4a5b-4c6d-8e7f-9a0b1c2d0004"/>
