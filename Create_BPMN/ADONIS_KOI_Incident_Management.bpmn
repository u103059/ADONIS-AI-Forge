    <startEvent name="Geprüfte Meldung eingegangen" id="_b4c68611-7459-41d8-a2b1-096ac7d06319">
      <outgoing>_091bd166-c9ae-462d-b706-5eb1f2c5b81e</outgoing>
      <messageEventDefinition id="msgEvtDef_b4c68611-7459-41d8-a2b1-096ac7d06319"/>
    </startEvent>

    <task name="Incident erfassen und kategorisieren" id="_c5d79722-856a-42e9-b3c2-1a7bd8e1741a" isForCompensation="false">
      <documentation textFormat="text/plain">Das Ticketsystem legt automatisiert einen Incident mit eindeutiger Ticketnummer an, ordnet ihn anhand von Schlagworten und betroffenem Service einer Kategorie zu und verknüpft ihn gegebenenfalls mit bekannten Fehlern. Ergebnis ist ein erfasster und kategorisierter Incident.</documentation>
      <incoming>_091bd166-c9ae-462d-b706-5eb1f2c5b81e</incoming>
      <outgoing>_1a2ce277-dabf-473e-8817-6fc203d6c91f</outgoing>
    </task>

    <task name="Incident priorisieren und zuweisen" id="_d6e8a833-967b-43fa-84d3-2b8ce9f2851b" isForCompensation="false">
      <documentation textFormat="text/plain">Das System ermittelt automatisiert die Priorität anhand von Auswirkung und Dringlichkeit (Prioritätsmatrix), weist den Incident der zuständigen Bearbeitergruppe zu und setzt die Reaktions- und Lösungsfristen (SLA). Ergebnis ist ein priorisierter, zugewiesener Incident, der an die Organisation übermittelt wird.</documentation>
      <incoming>_1a2ce277-dabf-473e-8817-6fc203d6c91f</incoming>
      <outgoing>_2b3df388-ebc0-484f-9928-70d314e7da20</outgoing>
    </task>

    <task name="Incident abschließen" id="_e7f9b944-a78c-440b-95e4-3c9df0a3961c" isForCompensation="false">
      <documentation textFormat="text/plain">Das System setzt den Incident auf den Status gelöst, protokolliert Bearbeitungszeiten und SLA-Einhaltung und archiviert den Incident samt Lösungsdokumentation. Ergebnis ist ein abgeschlossener Incident mit Protokoll, der der Organisation gemeldet wird.</documentation>
      <incoming>_2b3df388-ebc0-484f-9928-70d314e7da20</incoming>
      <outgoing>_3c4e0499-fcd1-495a-aa39-81e425f8eb21</outgoing>
    </task>

    <endEvent name="Incident abgeschlossen" id="_f80ac055-b89d-451c-a6f5-4da0e1b4a71d">
      <incoming>_3c4e0499-fcd1-495a-aa39-81e425f8eb21</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_b4c68611-7459-41d8-a2b1-096ac7d06319" targetRef="_c5d79722-856a-42e9-b3c2-1a7bd8e1741a" id="_091bd166-c9ae-462d-b706-5eb1f2c5b81e"/>
    <sequenceFlow sourceRef="_c5d79722-856a-42e9-b3c2-1a7bd8e1741a" targetRef="_d6e8a833-967b-43fa-84d3-2b8ce9f2851b" id="_1a2ce277-dabf-473e-8817-6fc203d6c91f"/>
