    <startEvent name="Störung festgestellt" id="_4dfb1fa9-0de2-4a61-9b24-92f3b06fce12">
      <outgoing>_81f353ed-4126-4ea5-bf68-d637f4ad3016</outgoing>
    </startEvent>

    <task name="Störung melden" id="_5e0c20ba-1ef3-4b72-8c35-a304c17a0d13" isForCompensation="false">
      <documentation textFormat="text/plain">Der Kunde beschreibt die festgestellte Störung mit Symptom, Zeitpunkt und betroffenem Service und übermittelt seine Kontaktdaten über das Online-Formular. Ergebnis ist eine vollständige Störungsmeldung, die an die Organisation gesendet wird.</documentation>
      <incoming>_81f353ed-4126-4ea5-bf68-d637f4ad3016</incoming>
      <outgoing>_92a464fe-5237-4fb6-80f9-e748a5be4117</outgoing>
    </task>

    <task name="Lösung bestätigen" id="_6f1d31cb-2f04-4c83-9d46-b415d28b1e14" isForCompensation="false">
      <documentation textFormat="text/plain">Der Kunde prüft anhand der Lösungsmitteilung, ob der Service wieder wie erwartet funktioniert, und bestätigt die Wiederherstellung. Ergebnis ist die bestätigte Lösung.</documentation>
      <incoming>_92a464fe-5237-4fb6-80f9-e748a5be4117</incoming>
      <outgoing>_a3b57500-6348-40c7-91a0-f859b6cf5218</outgoing>
    </task>

    <endEvent name="Störung behoben" id="_70e242dc-3015-4d94-ae57-c526e39c2f15">
      <incoming>_a3b57500-6348-40c7-91a0-f859b6cf5218</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_4dfb1fa9-0de2-4a61-9b24-92f3b06fce12" targetRef="_5e0c20ba-1ef3-4b72-8c35-a304c17a0d13" id="_81f353ed-4126-4ea5-bf68-d637f4ad3016"/>
    <sequenceFlow sourceRef="_5e0c20ba-1ef3-4b72-8c35-a304c17a0d13" targetRef="_6f1d31cb-2f04-4c83-9d46-b415d28b1e14" id="_92a464fe-5237-4fb6-80f9-e748a5be4117"/>
