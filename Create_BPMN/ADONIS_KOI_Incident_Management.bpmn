    <startEvent name="Störungsmeldung eingegangen" id="_4d5f15aa-0de2-4a6b-bb4a-92f536a9fc22">
      <outgoing>_a3b57b00-6348-40c1-91a0-f85b9c0fe528</outgoing>
      <messageEventDefinition id="msgEvtDef_4d5f15aa-0de2-4a6b-bb4a-92f536a9fc22"/>
    </startEvent>

    <task name="Meldung prüfen" id="_5e6026bb-1ef3-4b7c-8c5b-a30647bad023" isForCompensation="false">
      <documentation textFormat="text/plain">Der Service Desk prüft die Störungsmeldung auf Vollständigkeit, Plausibilität und Zuständigkeit und stellt sicher, dass es sich um einen Incident und nicht um eine Serviceanfrage handelt. Ergebnis ist die geprüfte und freigegebene Meldung, die an die IT übermittelt wird.</documentation>
      <incoming>_a3b57b00-6348-40c1-91a0-f85b9c0fe528</incoming>
      <outgoing>_b4c68c11-7459-41d2-a2b1-096cad10f629</outgoing>
    </task>

    <task name="Störung analysieren und beheben" id="_6f7137cc-2f04-4c8d-9d6c-b41758cbe124" isForCompensation="false">
      <documentation textFormat="text/plain">Die zugewiesene Fachkraft analysiert die Ursache der Störung anhand von Diagnose und Wissensdatenbank, setzt die Lösung oder eine Umgehungslösung um und testet die Wiederherstellung des Services. Ergebnis ist der wiederhergestellte Service.</documentation>
      <incoming>_b4c68c11-7459-41d2-a2b1-096cad10f629</incoming>
      <outgoing>_c5d79d22-856a-42e3-b3c2-1a7dbe21a72a</outgoing>
    </task>

    <task name="Lösung dokumentieren" id="_708248dd-3015-4d9e-ae7d-c52869dcf225" isForCompensation="false">
      <documentation textFormat="text/plain">Die Fachkraft hält Ursache, durchgeführte Maßnahmen und Lösung im Incident fest und ergänzt bei Bedarf die Wissensdatenbank. Ergebnis ist die dokumentierte Lösung, die an die IT übermittelt wird.</documentation>
      <incoming>_c5d79d22-856a-42e3-b3c2-1a7dbe21a72a</incoming>
      <outgoing>_d6e8ae33-967b-43f4-84d3-2b8ecf32b82b</outgoing>
    </task>

    <task name="Lösung mitteilen" id="_819359ee-4126-4eaf-bf8e-d6397aedc326" isForCompensation="false">
      <documentation textFormat="text/plain">Der Service Desk informiert den Kunden nach der Abschlussmeldung der IT über die Behebung der Störung und die durchgeführten Maßnahmen. Ergebnis ist die Lösungsmitteilung an den Kunden.</documentation>
      <incoming>_d6e8ae33-967b-43f4-84d3-2b8ecf32b82b</incoming>
      <outgoing>_e7f9bf44-a78c-4405-95e4-3c9fd043c92c</outgoing>
    </task>

    <endEvent name="Lösung mitgeteilt" id="_92a46aff-5237-4fb0-809f-e74a8bfed427">
      <incoming>_e7f9bf44-a78c-4405-95e4-3c9fd043c92c</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_4d5f15aa-0de2-4a6b-bb4a-92f536a9fc22" targetRef="_5e6026bb-1ef3-4b7c-8c5b-a30647bad023" id="_a3b57b00-6348-40c1-91a0-f85b9c0fe528"/>
    <sequenceFlow sourceRef="_5e6026bb-1ef3-4b7c-8c5b-a30647bad023" targetRef="_6f7137cc-2f04-4c8d-9d6c-b41758cbe124" id="_b4c68c11-7459-41d2-a2b1-096cad10f629"/>
