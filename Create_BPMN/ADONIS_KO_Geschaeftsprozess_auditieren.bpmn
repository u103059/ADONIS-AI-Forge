  <process name="Kunde"
           id="process_90000000-0000-4000-8000-000000000010"
           isExecutable="false"
           isClosed="false"
           processType="None">
    <laneSet id="laneSet_90000000-0000-4000-8000-000000000011">
      <lane name="Prozessverantwortlicher" id="_40000000-0000-4000-8000-000000000003">
        <flowNodeRef>_10000000-0000-4000-8000-000000000001</flowNodeRef>
        <flowNodeRef>_10000000-0000-4000-8000-000000000002</flowNodeRef>
        <flowNodeRef>_10000000-0000-4000-8000-000000000003</flowNodeRef>
        <flowNodeRef>_10000000-0000-4000-8000-000000000004</flowNodeRef>
        <flowNodeRef>_10000000-0000-4000-8000-000000000005</flowNodeRef>
        <flowNodeRef>_10000000-0000-4000-8000-000000000006</flowNodeRef>
        <flowNodeRef>_10000000-0000-4000-8000-000000000007</flowNodeRef>
        <flowNodeRef>_10000000-0000-4000-8000-000000000008</flowNodeRef>
        <flowNodeRef>_10000000-0000-4000-8000-000000000009</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Auditbedarf erkannt" id="_10000000-0000-4000-8000-000000000001">
      <outgoing>_11000000-0000-4000-8000-000000000001</outgoing>
    </startEvent>
    <task name="Auditauftrag übermitteln" id="_10000000-0000-4000-8000-000000000002" isForCompensation="false">
      <documentation textFormat="text/plain">Der Prozessverantwortliche benennt den zu prüfenden Geschäftsprozess und den Anlass des Audits und übermittelt den Prüfbedarf an die Auditkoordination. Ergebnis ist ein eingegangener Auditauftrag.</documentation>
      <incoming>_11000000-0000-4000-8000-000000000001</incoming>
      <outgoing>_11000000-0000-4000-8000-000000000002</outgoing>
    </task>
    <intermediateCatchEvent name="Auftragsbestätigung erhalten" id="_10000000-0000-4000-8000-000000000003">
      <incoming>_11000000-0000-4000-8000-000000000002</incoming>
      <outgoing>_11000000-0000-4000-8000-000000000003</outgoing>
      <messageEventDefinition id="_50000000-0000-4000-8000-000000000001"/>
    </intermediateCatchEvent>
    <task name="Prozessunterlagen bereitstellen" id="_10000000-0000-4000-8000-000000000004" isForCompensation="false">
      <documentation textFormat="text/plain">Der Prozessverantwortliche stellt die aktuelle Prozessbeschreibung, relevante Arbeitsanweisungen und vorhandene Nachweise zusammen und übermittelt sie dem Auditteam. Ergebnis ist die Bereitstellung der Prüfungsunterlagen.</documentation>
      <incoming>_11000000-0000-4000-8000-000000000003</incoming>
      <outgoing>_11000000-0000-4000-8000-000000000004</outgoing>
    </task>
    <intermediateCatchEvent name="Prüfplan erhalten" id="_10000000-0000-4000-8000-000000000005">
      <incoming>_11000000-0000-4000-8000-000000000004</incoming>
      <outgoing>_11000000-0000-4000-8000-000000000005</outgoing>
      <messageEventDefinition id="_50000000-0000-4000-8000-000000000002"/>
    </intermediateCatchEvent>
    <task name="Prüfungstermin bestätigen" id="_10000000-0000-4000-8000-000000000006" isForCompensation="false">
      <documentation textFormat="text/plain">Der Prozessverantwortliche stimmt dem im Prüfplan vorgeschlagenen Termin zu und stellt die Verfügbarkeit der benötigten Auskunftspersonen sicher. Ergebnis ist ein bestätigter Prüfungstermin.</documentation>
      <incoming>_11000000-0000-4000-8000-000000000005</incoming>
      <outgoing>_11000000-0000-4000-8000-000000000006</outgoing>
    </task>
    <task name="Prüfung unterstützen" id="_10000000-0000-4000-8000-000000000007" isForCompensation="false">
      <documentation textFormat="text/plain">Der Prozessverantwortliche erläutert dem Auditor den tatsächlichen Prozessablauf, beantwortet die abgestimmten Prüfungsfragen und stellt angefragte Nachweise bereit. Ergebnis sind Auskünfte und Prozessnachweise für die Prüfung.</documentation>
      <incoming>_11000000-0000-4000-8000-000000000006</incoming>
      <outgoing>_11000000-0000-4000-8000-000000000007</outgoing>
    </task>
    <intermediateCatchEvent name="Auditbericht erhalten" id="_10000000-0000-4000-8000-000000000008">
      <incoming>_11000000-0000-4000-8000-000000000007</incoming>
      <outgoing>_11000000-0000-4000-8000-000000000008</outgoing>
      <messageEventDefinition id="_50000000-0000-4000-8000-000000000003"/>
    </intermediateCatchEvent>
    <endEvent name="Auditbericht erhalten" id="_10000000-0000-4000-8000-000000000009">
      <incoming>_11000000-0000-4000-8000-000000000008</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_10000000-0000-4000-8000-000000000001" targetRef="_10000000-0000-4000-8000-000000000002" id="_11000000-0000-4000-8000-000000000001"/>
    <sequenceFlow sourceRef="_10000000-0000-4000-8000-000000000002" targetRef="_10000000-0000-4000-8000-000000000003" id="_11000000-0000-4000-8000-000000000002"/>
    <sequenceFlow sourceRef="_10000000-0000-4000-8000-000000000003" targetRef="_10000000-0000-4000-8000-000000000004" id="_11000000-0000-4000-8000-000000000003"/>
    <sequenceFlow sourceRef="_10000000-0000-4000-8000-000000000004" targetRef="_10000000-0000-4000-8000-000000000005" id="_11000000-0000-4000-8000-000000000004"/>
    <sequenceFlow sourceRef="_10000000-0000-4000-8000-000000000005" targetRef="_10000000-0000-4000-8000-000000000006" id="_11000000-0000-4000-8000-000000000005"/>
    <sequenceFlow sourceRef="_10000000-0000-4000-8000-000000000006" targetRef="_10000000-0000-4000-8000-000000000007" id="_11000000-0000-4000-8000-000000000006"/>
    <sequenceFlow sourceRef="_10000000-0000-4000-8000-000000000007" targetRef="_10000000-0000-4000-8000-000000000008" id="_11000000-0000-4000-8000-000000000007"/>
    <sequenceFlow sourceRef="_10000000-0000-4000-8000-000000000008" targetRef="_10000000-0000-4000-8000-000000000009" id="_11000000-0000-4000-8000-000000000008"/>
  </process>

  <process name="Organisation"
           id="process_90000000-0000-4000-8000-000000000020"
           isExecutable="false"
           isClosed="false"
           processType="None">
    <laneSet id="laneSet_90000000-0000-4000-8000-000000000021">
      <lane name="Auditkoordination" id="_40000000-0000-4000-8000-000000000004">
        <flowNodeRef>_20000000-0000-4000-8000-000000000001</flowNodeRef>
        <flowNodeRef>_20000000-0000-4000-8000-000000000002</flowNodeRef>
        <flowNodeRef>_20000000-0000-4000-8000-000000000003</flowNodeRef>
        <flowNodeRef>_20000000-0000-4000-8000-000000000004</flowNodeRef>
        <flowNodeRef>_20000000-0000-4000-8000-000000000005</flowNodeRef>
        <flowNodeRef>_20000000-0000-4000-8000-000000000006</flowNodeRef>
        <flowNodeRef>_20000000-0000-4000-8000-000000000010</flowNodeRef>
        <flowNodeRef>_20000000-0000-4000-8000-000000000011</flowNodeRef>
        <flowNodeRef>_20000000-0000-4000-8000-000000000012</flowNodeRef>
        <flowNodeRef>_20000000-0000-4000-8000-000000000013</flowNodeRef>
      </lane>
      <lane name="Auditor" id="_40000000-0000-4000-8000-000000000005">
        <flowNodeRef>_21000000-0000-4000-8000-000000000001</flowNodeRef>
        <flowNodeRef>_21000000-0000-4000-8000-000000000002</flowNodeRef>
        <flowNodeRef>_21000000-0000-4000-8000-000000000003</flowNodeRef>
        <flowNodeRef>_21000000-0000-4000-8000-000000000004</flowNodeRef>
        <flowNodeRef>_21000000-0000-4000-8000-000000000005</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent name="Auditauftrag eingegangen" id="_20000000-0000-4000-8000-000000000001">
      <outgoing>_22000000-0000-4000-8000-000000000001</outgoing>
      <messageEventDefinition id="_50000000-0000-4000-8000-000000000004"/>
    </startEvent>
    <task name="Auditauftrag erfassen" id="_20000000-0000-4000-8000-000000000002" isForCompensation="false">
      <documentation textFormat="text/plain">Die Auditkoordination erfasst den Prüfauftrag mit der Prozessbezeichnung und dem vom Prozessverantwortlichen benannten Anlass. Ergebnis ist ein dokumentierter Auditvorgang.</documentation>
      <incoming>_22000000-0000-4000-8000-000000000001</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000002</outgoing>
    </task>
    <task name="Auftragsübernahme bestätigen" id="_20000000-0000-4000-8000-000000000003" isForCompensation="false">
      <documentation textFormat="text/plain">Die Auditkoordination bestätigt dem Prozessverantwortlichen die Übernahme des Auditauftrags. Ergebnis ist eine übermittelte Auftragsbestätigung.</documentation>
      <incoming>_22000000-0000-4000-8000-000000000002</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000003</outgoing>
    </task>
    <intermediateCatchEvent name="Prüfungsunterlagen eingegangen" id="_20000000-0000-4000-8000-000000000004">
      <incoming>_22000000-0000-4000-8000-000000000003</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000004</outgoing>
      <messageEventDefinition id="_50000000-0000-4000-8000-000000000005"/>
    </intermediateCatchEvent>
    <task name="Prüfplan erstellen und übermitteln" id="_20000000-0000-4000-8000-000000000005" isForCompensation="false">
      <documentation textFormat="text/plain">Die Auditkoordination legt anhand des Auftrags und der eingegangenen Unterlagen Prüfungsumfang, Kriterien und Terminvorschlag fest und übermittelt diese Angaben dem Prozessverantwortlichen. Ergebnis ist ein abgestimmter Prüfplan zur Terminbestätigung.</documentation>
      <incoming>_22000000-0000-4000-8000-000000000004</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000005</outgoing>
    </task>
    <intermediateCatchEvent name="Prüfungstermin bestätigt" id="_20000000-0000-4000-8000-000000000006">
      <incoming>_22000000-0000-4000-8000-000000000005</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000006</outgoing>
      <messageEventDefinition id="_50000000-0000-4000-8000-000000000006"/>
    </intermediateCatchEvent>
    <intermediateThrowEvent name="Prüfauftrag übernommen" id="_21000000-0000-4000-8000-000000000001">
      <incoming>_22000000-0000-4000-8000-000000000006</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000007</outgoing>
    </intermediateThrowEvent>
    <task name="Prüfungsunterlagen analysieren" id="_21000000-0000-4000-8000-000000000002" isForCompensation="false">
      <documentation textFormat="text/plain">Der Auditor sichtet die Prozessbeschreibung, relevanten Arbeitsanweisungen und bereitgestellten Nachweise im Abgleich mit den im Prüfplan festgelegten Kriterien. Ergebnis ist eine strukturierte Grundlage für die Prüfung des Prozessablaufs.</documentation>
      <incoming>_22000000-0000-4000-8000-000000000007</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000008</outgoing>
    </task>
    <task name="Prozessablauf untersuchen" id="_21000000-0000-4000-8000-000000000003" isForCompensation="false">
      <documentation textFormat="text/plain">Der Auditor untersucht den erläuterten Prozessablauf anhand der festgelegten Kriterien, führt das abgestimmte Prüfungsgespräch und betrachtet die bereitgestellten Nachweise. Ergebnis sind geprüfte Sachverhalte mit nachvollziehbarer Beleggrundlage.</documentation>
      <incoming>_22000000-0000-4000-8000-000000000008</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000009</outgoing>
    </task>
    <task name="Prüfergebnisse dokumentieren" id="_21000000-0000-4000-8000-000000000004" isForCompensation="false">
      <documentation textFormat="text/plain">Der Auditor hält Prüfungsumfang, geprüfte Sachverhalte, Belege und Ergebnisse strukturiert fest. Ergebnis ist eine nachvollziehbare Dokumentation der Prüfergebnisse.</documentation>
      <incoming>_22000000-0000-4000-8000-000000000009</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000010</outgoing>
    </task>
    <intermediateThrowEvent name="Prüfergebnisse übergeben" id="_21000000-0000-4000-8000-000000000005">
      <incoming>_22000000-0000-4000-8000-000000000010</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000011</outgoing>
    </intermediateThrowEvent>
    <intermediateCatchEvent name="Prüfergebnisse übernommen" id="_20000000-0000-4000-8000-000000000010">
      <incoming>_22000000-0000-4000-8000-000000000011</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000012</outgoing>
    </intermediateCatchEvent>
    <task name="Auditbericht erstellen" id="_20000000-0000-4000-8000-000000000011" isForCompensation="false">
      <documentation textFormat="text/plain">Die Auditkoordination fasst Prüfungsumfang, Kriterien, Vorgehen und dokumentierte Ergebnisse im Auditbericht zusammen. Ergebnis ist ein nachvollziehbarer Auditbericht.</documentation>
      <incoming>_22000000-0000-4000-8000-000000000012</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000013</outgoing>
    </task>
    <task name="Auditbericht übermitteln" id="_20000000-0000-4000-8000-000000000012" isForCompensation="false">
      <documentation textFormat="text/plain">Die Auditkoordination übermittelt den fertigen Auditbericht an den Prozessverantwortlichen. Ergebnis ist der dem Kunden bereitgestellte Auditbericht.</documentation>
      <incoming>_22000000-0000-4000-8000-000000000013</incoming>
      <outgoing>_22000000-0000-4000-8000-000000000014</outgoing>
    </task>
    <endEvent name="Auditbericht übermittelt" id="_20000000-0000-4000-8000-000000000013">
      <incoming>_22000000-0000-4000-8000-000000000014</incoming>
    </endEvent>

    <sequenceFlow sourceRef="_20000000-0000-4000-8000-000000000001" targetRef="_20000000-0000-4000-8000-000000000002" id="_22000000-0000-4000-8000-000000000001"/>
    <sequenceFlow sourceRef="_20000000-0000-4000-8000-000000000002" targetRef="_20000000-0000-4000-8000-000000000003" id="_22000000-0000-4000-8000-000000000002"/>
