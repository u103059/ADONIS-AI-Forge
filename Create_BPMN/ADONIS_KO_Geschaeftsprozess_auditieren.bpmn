    <bpmn:messageFlow id="_30000000-0000-4000-8000-000000000004" name="Pruefplan mit Kriterien und Termin" sourceRef="_20000000-0000-4000-8000-000000000005" targetRef="_10000000-0000-4000-8000-000000000005">
      <bpmn:extensionElements>
