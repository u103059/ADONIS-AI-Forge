      <bpmndi:BPMNShape bpmnElement="_10000000-0000-4000-8000-000000000003">
        <omgdc:Bounds x="440" y="172" width="36" height="36"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="408" y="213" width="100" height="40"/></bpmndi:BPMNLabel>
