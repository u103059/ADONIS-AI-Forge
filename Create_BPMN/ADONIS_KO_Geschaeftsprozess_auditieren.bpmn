  </bpmn:collaboration>
  <bpmn:process id="process_90000000-0000-4000-8000-000000000010" name="Kunde" processType="None" isClosed="false" isExecutable="false">
    <bpmn:laneSet id="laneSet_90000000-0000-4000-8000-000000000011">
      <bpmn:lane id="_40000000-0000-4000-8000-000000000003" name="Prozessverantwortlicher">
        <bpmn:flowNodeRef>_10000000-0000-4000-8000-000000000001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_10000000-0000-4000-8000-000000000002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_10000000-0000-4000-8000-000000000003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_10000000-0000-4000-8000-000000000004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_10000000-0000-4000-8000-000000000005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_10000000-0000-4000-8000-000000000006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_10000000-0000-4000-8000-000000000007</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_10000000-0000-4000-8000-000000000008</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_10000000-0000-4000-8000-000000000009</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="_10000000-0000-4000-8000-000000000001" name="Auditbedarf erkannt">
      <bpmn:outgoing>_11000000-0000-4000-8000-000000000001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="_10000000-0000-4000-8000-000000000002" name="Auditauftrag übermitteln">
      <bpmn:documentation>Der Prozessverantwortliche benennt den zu prüfenden Geschäftsprozess und den Anlass des Audits und übermittelt den Prüfbedarf an die Auditkoordination. Ergebnis ist ein eingegangener Auditauftrag.</bpmn:documentation>
      <bpmn:incoming>_11000000-0000-4000-8000-000000000001</bpmn:incoming>
      <bpmn:outgoing>_11000000-0000-4000-8000-000000000002</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="_10000000-0000-4000-8000-000000000003" name="Auftragsbestätigung erhalten">
      <bpmn:incoming>_11000000-0000-4000-8000-000000000002</bpmn:incoming>
      <bpmn:outgoing>_11000000-0000-4000-8000-000000000003</bpmn:outgoing>
      <bpmn:messageEventDefinition id="_50000000-0000-4000-8000-000000000001" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="_10000000-0000-4000-8000-000000000004" name="Prozessunterlagen bereitstellen">
      <bpmn:documentation>Der Prozessverantwortliche stellt die aktuelle Prozessbeschreibung, relevante Arbeitsanweisungen und vorhandene Nachweise zusammen und übermittelt sie dem Auditteam. Ergebnis ist die Bereitstellung der Prüfungsunterlagen.</bpmn:documentation>
      <bpmn:incoming>_11000000-0000-4000-8000-000000000003</bpmn:incoming>
      <bpmn:outgoing>_11000000-0000-4000-8000-000000000004</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="_10000000-0000-4000-8000-000000000005" name="Prüfplan erhalten">
      <bpmn:incoming>_11000000-0000-4000-8000-000000000004</bpmn:incoming>
      <bpmn:outgoing>_11000000-0000-4000-8000-000000000005</bpmn:outgoing>
      <bpmn:messageEventDefinition id="_50000000-0000-4000-8000-000000000002" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="_10000000-0000-4000-8000-000000000006" name="Prüfungstermin bestätigen">
      <bpmn:documentation>Der Prozessverantwortliche stimmt dem im Prüfplan vorgeschlagenen Termin zu und stellt die Verfügbarkeit der benötigten Auskunftspersonen sicher. Ergebnis ist ein bestätigter Prüfungstermin.</bpmn:documentation>
      <bpmn:incoming>_11000000-0000-4000-8000-000000000005</bpmn:incoming>
      <bpmn:outgoing>_11000000-0000-4000-8000-000000000006</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="_10000000-0000-4000-8000-000000000007" name="Prüfung unterstützen">
      <bpmn:documentation>Der Prozessverantwortliche erläutert dem Auditor den tatsächlichen Prozessablauf, beantwortet die abgestimmten Prüfungsfragen und stellt angefragte Nachweise bereit. Ergebnis sind Auskünfte und Prozessnachweise für die Prüfung.</bpmn:documentation>
      <bpmn:incoming>_11000000-0000-4000-8000-000000000006</bpmn:incoming>
      <bpmn:outgoing>_11000000-0000-4000-8000-000000000007</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="_10000000-0000-4000-8000-000000000008" name="Auditbericht erhalten">
      <bpmn:incoming>_11000000-0000-4000-8000-000000000007</bpmn:incoming>
      <bpmn:outgoing>_11000000-0000-4000-8000-000000000008</bpmn:outgoing>
      <bpmn:messageEventDefinition id="_50000000-0000-4000-8000-000000000003" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="_10000000-0000-4000-8000-000000000009" name="Auditbericht erhalten">
      <bpmn:incoming>_11000000-0000-4000-8000-000000000008</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="_11000000-0000-4000-8000-000000000001" sourceRef="_10000000-0000-4000-8000-000000000001" targetRef="_10000000-0000-4000-8000-000000000002" />
    <bpmn:sequenceFlow id="_11000000-0000-4000-8000-000000000002" sourceRef="_10000000-0000-4000-8000-000000000002" targetRef="_10000000-0000-4000-8000-000000000003" />
    <bpmn:sequenceFlow id="_11000000-0000-4000-8000-000000000003" sourceRef="_10000000-0000-4000-8000-000000000003" targetRef="_10000000-0000-4000-8000-000000000004" />
    <bpmn:sequenceFlow id="_11000000-0000-4000-8000-000000000004" sourceRef="_10000000-0000-4000-8000-000000000004" targetRef="_10000000-0000-4000-8000-000000000005" />
    <bpmn:sequenceFlow id="_11000000-0000-4000-8000-000000000005" sourceRef="_10000000-0000-4000-8000-000000000005" targetRef="_10000000-0000-4000-8000-000000000006" />
    <bpmn:sequenceFlow id="_11000000-0000-4000-8000-000000000006" sourceRef="_10000000-0000-4000-8000-000000000006" targetRef="_10000000-0000-4000-8000-000000000007" />
    <bpmn:sequenceFlow id="_11000000-0000-4000-8000-000000000007" sourceRef="_10000000-0000-4000-8000-000000000007" targetRef="_10000000-0000-4000-8000-000000000008" />
    <bpmn:sequenceFlow id="_11000000-0000-4000-8000-000000000008" sourceRef="_10000000-0000-4000-8000-000000000008" targetRef="_10000000-0000-4000-8000-000000000009" />
  </bpmn:process>
  <bpmn:process id="process_90000000-0000-4000-8000-000000000020" name="Organisation" processType="None" isClosed="false" isExecutable="false">
    <bpmn:laneSet id="laneSet_90000000-0000-4000-8000-000000000021">
      <bpmn:lane id="_40000000-0000-4000-8000-000000000004" name="Auditkoordination">
        <bpmn:flowNodeRef>_20000000-0000-4000-8000-000000000001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_20000000-0000-4000-8000-000000000002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_20000000-0000-4000-8000-000000000003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_20000000-0000-4000-8000-000000000004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_20000000-0000-4000-8000-000000000005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_20000000-0000-4000-8000-000000000006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_20000000-0000-4000-8000-000000000010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_20000000-0000-4000-8000-000000000011</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_20000000-0000-4000-8000-000000000012</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_20000000-0000-4000-8000-000000000013</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_40000000-0000-4000-8000-000000000005" name="Auditor">
        <bpmn:flowNodeRef>_21000000-0000-4000-8000-000000000001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_21000000-0000-4000-8000-000000000002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_21000000-0000-4000-8000-000000000003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_21000000-0000-4000-8000-000000000004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_21000000-0000-4000-8000-000000000005</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="_20000000-0000-4000-8000-000000000001" name="Auditauftrag eingegangen">
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000001</bpmn:outgoing>
      <bpmn:messageEventDefinition id="_50000000-0000-4000-8000-000000000004" />
    </bpmn:startEvent>
    <bpmn:task id="_20000000-0000-4000-8000-000000000002" name="Auditauftrag erfassen">
      <bpmn:documentation>Die Auditkoordination erfasst den Prüfauftrag mit der Prozessbezeichnung und dem vom Prozessverantwortlichen benannten Anlass. Ergebnis ist ein dokumentierter Auditvorgang.</bpmn:documentation>
      <bpmn:incoming>_22000000-0000-4000-8000-000000000001</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000002</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="_20000000-0000-4000-8000-000000000003" name="Auftragsübernahme bestätigen">
      <bpmn:documentation>Die Auditkoordination bestätigt dem Prozessverantwortlichen die Übernahme des Auditauftrags. Ergebnis ist eine übermittelte Auftragsbestätigung.</bpmn:documentation>
      <bpmn:incoming>_22000000-0000-4000-8000-000000000002</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000003</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="_20000000-0000-4000-8000-000000000004" name="Prüfungsunterlagen eingegangen">
      <bpmn:incoming>_22000000-0000-4000-8000-000000000003</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000004</bpmn:outgoing>
      <bpmn:messageEventDefinition id="_50000000-0000-4000-8000-000000000005" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="_20000000-0000-4000-8000-000000000005" name="Prüfplan erstellen und übermitteln">
      <bpmn:documentation>Die Auditkoordination legt anhand des Auftrags und der eingegangenen Unterlagen Prüfungsumfang, Kriterien und Terminvorschlag fest und übermittelt diese Angaben dem Prozessverantwortlichen. Ergebnis ist ein abgestimmter Prüfplan zur Terminbestätigung.</bpmn:documentation>
      <bpmn:incoming>_22000000-0000-4000-8000-000000000004</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000005</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="_20000000-0000-4000-8000-000000000006" name="Prüfungstermin bestätigt">
      <bpmn:incoming>_22000000-0000-4000-8000-000000000005</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000006</bpmn:outgoing>
      <bpmn:messageEventDefinition id="_50000000-0000-4000-8000-000000000006" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_21000000-0000-4000-8000-000000000001" name="Prüfauftrag übernommen">
      <bpmn:incoming>_22000000-0000-4000-8000-000000000006</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000007</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="_21000000-0000-4000-8000-000000000002" name="Prüfungsunterlagen analysieren">
      <bpmn:documentation>Der Auditor sichtet die Prozessbeschreibung, relevanten Arbeitsanweisungen und bereitgestellten Nachweise im Abgleich mit den im Prüfplan festgelegten Kriterien. Ergebnis ist eine strukturierte Grundlage für die Prüfung des Prozessablaufs.</bpmn:documentation>
      <bpmn:incoming>_22000000-0000-4000-8000-000000000007</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000008</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="_21000000-0000-4000-8000-000000000003" name="Prozessablauf untersuchen">
      <bpmn:documentation>Der Auditor untersucht den erläuterten Prozessablauf anhand der festgelegten Kriterien, führt das abgestimmte Prüfungsgespräch und betrachtet die bereitgestellten Nachweise. Ergebnis sind geprüfte Sachverhalte mit nachvollziehbarer Beleggrundlage.</bpmn:documentation>
      <bpmn:incoming>_22000000-0000-4000-8000-000000000008</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000009</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="_21000000-0000-4000-8000-000000000004" name="Prüfergebnisse dokumentieren">
      <bpmn:documentation>Der Auditor hält Prüfungsumfang, geprüfte Sachverhalte, Belege und Ergebnisse strukturiert fest. Ergebnis ist eine nachvollziehbare Dokumentation der Prüfergebnisse.</bpmn:documentation>
      <bpmn:incoming>_22000000-0000-4000-8000-000000000009</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000010</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="_21000000-0000-4000-8000-000000000005" name="Prüfergebnisse übergeben">
      <bpmn:incoming>_22000000-0000-4000-8000-000000000010</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000011</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="_20000000-0000-4000-8000-000000000010" name="Prüfergebnisse übernommen">
      <bpmn:incoming>_22000000-0000-4000-8000-000000000011</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000012</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="_20000000-0000-4000-8000-000000000011" name="Auditbericht erstellen">
      <bpmn:documentation>Die Auditkoordination fasst Prüfungsumfang, Kriterien, Vorgehen und dokumentierte Ergebnisse im Auditbericht zusammen. Ergebnis ist ein nachvollziehbarer Auditbericht.</bpmn:documentation>
      <bpmn:incoming>_22000000-0000-4000-8000-000000000012</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000013</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="_20000000-0000-4000-8000-000000000012" name="Auditbericht übermitteln">
      <bpmn:documentation>Die Auditkoordination übermittelt den fertigen Auditbericht an den Prozessverantwortlichen. Ergebnis ist der dem Kunden bereitgestellte Auditbericht.</bpmn:documentation>
      <bpmn:incoming>_22000000-0000-4000-8000-000000000013</bpmn:incoming>
      <bpmn:outgoing>_22000000-0000-4000-8000-000000000014</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="_20000000-0000-4000-8000-000000000013" name="Auditbericht übermittelt">
      <bpmn:incoming>_22000000-0000-4000-8000-000000000014</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="_22000000-0000-4000-8000-000000000001" sourceRef="_20000000-0000-4000-8000-000000000001" targetRef="_20000000-0000-4000-8000-000000000002" />
    <bpmn:sequenceFlow id="_22000000-0000-4000-8000-000000000002" sourceRef="_20000000-0000-4000-8000-000000000002" targetRef="_20000000-0000-4000-8000-000000000003" />
    <bpmn:sequenceFlow id="_22000000-0000-4000-8000-000000000003" sourceRef="_20000000-0000-4000-8000-000000000003" targetRef="_20000000-0000-4000-8000-000000000004" />
    <bpmn:sequenceFlow id="_22000000-0000-4000-8000-000000000004" sourceRef="_20000000-0000-4000-8000-000000000004" targetRef="_20000000-0000-4000-8000-000000000005" />
    <bpmn:sequenceFlow id="_22000000-0000-4000-8000-000000000005" sourceRef="_20000000-0000-4000-8000-000000000005" targetRef="_20000000-0000-4000-8000-000000000006" />
    <bpmn:sequenceFlow id="_22000000-0000-4000-8000-000000000006" sourceRef="_20000000-0000-4000-8000-000000000006" targetRef="_21000000-0000-4000-8000-000000000001" />
    <bpmn:sequenceFlow id="_22000000-0000-4000-8000-000000000007" sourceRef="_21000000-0000-4000-8000-000000000001" targetRef="_21000000-0000-4000-8000-000000000002" />
    <bpmn:sequenceFlow id="_22000000-0000-4000-8000-000000000008" sourceRef="_21000000-0000-4000-8000-000000000002" targetRef="_21000000-0000-4000-8000-000000000003" />
    <bpmn:sequenceFlow id="_22000000-0000-4000-8000-000000000009" sourceRef="_21000000-0000-4000-8000-000000000003" targetRef="_21000000-0000-4000-8000-000000000004" />
