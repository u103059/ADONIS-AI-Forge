# Kopieren nach .env und Werte eintragen. .env niemals committen.
ADONIS_BASE_URL=https://adonis.lhs.stuttgart.de:8443/adonisnp
ADONIS_USER=
ADONIS_PASSWORD=

# Optional
ADONIS_REPO_ID=
ADONIS_CA_BUNDLE=
ADONIS_API_ROOT=/rest/2.0
ADONIS_MODEL_CLASS=MT_BUSINESS_PROCESS_DIAGRAM_BPMN_20
ADONIS_STATUS_ATTR=MFB_RWF_STATE
ADONIS_STATUS_VALUE=In methodischer Prüfung
ADONIS_EXPORT_PATH=/repos/{repo_id}/models/{model_id}/format?format=bpmn
# Vollstaendige Such-Query (JSON) ueberschreibt MODEL_CLASS/STATUS_ATTR
ADONIS_SEARCH_QUERY=
